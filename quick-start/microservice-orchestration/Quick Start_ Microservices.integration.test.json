{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "template-microservice-tutorial-18us19m",
  "testCases": [
    {
      "name": "Microservice called successfully",
      "description": "The test completes the microservice job in place of the tutorial's Java worker, with the same result (resultValue1 = 42), and the process reaches the end event. Stop worker-java before running this test, or the worker takes the job first.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "template-microservice-tutorial-18us19m"
          },
          "variables": {}
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Run_microservice"
          },
          "variables": {
            "resultValue1": 42
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "template-microservice-tutorial-18us19m"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "template-microservice-tutorial-18us19m"
          },
          "elementSelector": {
            "elementId": "EndEvent"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "template-microservice-tutorial-18us19m"
          },
          "variables": {
            "resultValue1": 42
          }
        }
      ]
    }
  ]
}
