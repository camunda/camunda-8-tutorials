<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_a2a_card_dispute" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="a2a-card-dispute" name="03 Server Agent - A2A Skeleton" isExecutable="true">
    <bpmn:startEvent id="TaskReceived" name="Request received">
      <bpmn:outgoing>Flow_TaskReceived_AgentTools</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="AgentTools" name="Server AI agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openaiCompatible" target="provider.type" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT}}" target="provider.openaiCompatible.endpoint" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_KEY}}" target="provider.openaiCompatible.authentication.apiKey" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL}}" target="provider.openaiCompatible.model.model" />
          <zeebe:input source="=0" target="provider.openaiCompatible.model.parameters.temperature" />
          <zeebe:input source="=&#34;You run a minimal BPMN A2A skeleton. Call echo_placeholder for the supplied request. The tool reads demoInput from the request (a data part or JSON text) and accepts no model-provided arguments. Do not invent or alter its value. If the request does not carry a demoInput object with a non-blank string value, do not call the tool; briefly explain what is missing and finish. After the tool returns, briefly report the result and finish. Do not request human input.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Handle this A2A request. Message parts: &#34; + string(req.message.parts)" target="data.userPrompt.prompt" />
          <zeebe:input source="=null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="agent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="errorExpression" value="=if error != null then bpmnError(&#34;AGENT_FAILED&#34;, string(error.message)) else null" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TaskReceived_AgentTools</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentTools_AgentFinished</bpmn:outgoing>
      <bpmn:scriptTask id="echo_placeholder" name="Share placeholder">
        <bpmn:documentation>Call once to return the process-owned placeholder value. Accepts no model arguments. Replace this tool with your own business logic.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=/* demoInput from the data part, else parsed from JSON text (e.g. clients that send text only). */&#10;if req.message.parts instance of list&#10;  then (if count(req.message.parts[item instance of context and item.data != null]) &gt; 0&#10;    then req.message.parts[item instance of context and item.data != null][1].data.demoInput&#10;    else from json(req.message.parts[item instance of context and item.text != null][1].text))&#10;  else null" target="requestData" />
          </zeebe:ioMapping>
          <zeebe:script expression="=requestData" resultVariable="toolCallResult" />
          <zeebe:properties>
            <zeebe:property name="a2a:tags" value="placeholder" />
            <zeebe:property name="a2a:examples" value="Example input" />
          </zeebe:properties>
        </bpmn:extensionElements>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="AgentFinished" name="Agent finished">
      <bpmn:incoming>Flow_AgentTools_AgentFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_TaskReceived_AgentTools" sourceRef="TaskReceived" targetRef="AgentTools" />
    <bpmn:sequenceFlow id="Flow_AgentTools_AgentFinished" sourceRef="AgentTools" targetRef="AgentFinished" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_a2a-card-dispute">
    <bpmndi:BPMNPlane id="BPMNPlane_a2a-card-dispute" bpmnElement="a2a-card-dispute">
      <bpmndi:BPMNShape id="TaskReceived_di" bpmnElement="TaskReceived">
        <dc:Bounds x="177" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="152" y="198" width="86" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentTools_di" bpmnElement="AgentTools" isExpanded="true">
        <dc:Bounds x="250" y="80" width="270" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="echo_placeholder_di" bpmnElement="echo_placeholder">
        <dc:Bounds x="330" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AgentFinished_di" bpmnElement="AgentFinished">
        <dc:Bounds x="582" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="561" y="198" width="78" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_TaskReceived_AgentTools_di" bpmnElement="Flow_TaskReceived_AgentTools">
        <di:waypoint x="213" y="180" />
        <di:waypoint x="250" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AgentTools_AgentFinished_di" bpmnElement="Flow_AgentTools_AgentFinished">
        <di:waypoint x="520" y="180" />
        <di:waypoint x="582" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
