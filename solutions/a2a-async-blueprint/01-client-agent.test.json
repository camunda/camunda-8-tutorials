{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "processId": "a2a-client",
  "testCases": [
    {
      "name": "Agent sends a message through the native A2A Client tool - polling delivers the result",
      "description": "The A2A Client connector (tool mode, polling) returns a working task; the polling catch event correlates on pollingData.id and returns the completed task as the tool result.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-client"
          }
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "activateElements": [
            {
              "elementId": "A2AClient",
              "variables": {
                "toolCall": {
                  "_meta": {
                    "id": "call-1",
                    "name": "A2AClient"
                  },
                  "operation": "sendMessage",
                  "params": {
                    "text": "{\"value\":\"Example input\"}"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "A2AClient"
          },
          "variables": {
            "toolCallResult": {
              "result": {
                "kind": "task",
                "id": "remote-task-1",
                "contextId": "ctx-1",
                "status": {
                  "state": "submitted"
                }
              },
              "pollingData": {
                "id": "remote-task-1"
              }
            }
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "elementSelector": {
            "elementId": "A2ATaskResult"
          },
          "state": "IS_ACTIVE"
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "cf4a9562-6ffe-4810-b082-db16822578ff",
          "correlationKey": "remote-task-1",
          "variables": {
            "toolCallResult": {
              "kind": "task",
              "id": "remote-task-1",
              "contextId": "ctx-1",
              "status": {
                "state": "completed"
              },
              "artifacts": [
                {
                  "artifactId": "a-1",
                  "parts": [
                    {
                      "text": "Example input"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "elementSelector": {
            "elementId": "A2ATaskResult"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "completionConditionFulfilled": true,
          "variables": {
            "agent": {
              "responseText": "Done."
            }
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
