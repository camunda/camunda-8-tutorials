{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "processId": "a2a-client",
  "testCases": [
    {
      "name": "Client agent delegates once - the protocol process runs as a tool",
      "description": "The agent calls DelegateRequest; the client protocol process (05) is mocked and returns the settled task.",
      "instructions": [
        {
          "type": "MOCK_CHILD_PROCESS",
          "processDefinitionId": "a2a-client-protocol",
          "variables": {
            "remoteResponse": {
              "jsonrpc": "2.0",
              "id": "r",
              "result": {
                "task": {
                  "id": "demo-task",
                  "contextId": "demo-context",
                  "status": {
                    "state": "TASK_STATE_COMPLETED"
                  },
                  "artifacts": [
                    {
                      "artifactId": "a-1",
                      "name": "placeholder",
                      "parts": [
                        {
                          "data": {
                            "value": "Example input"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            },
            "acceptedTask": {
              "id": "demo-task",
              "contextId": "demo-context",
              "status": {
                "state": "TASK_STATE_COMPLETED"
              },
              "artifacts": [
                {
                  "artifactId": "a-1",
                  "name": "placeholder",
                  "parts": [
                    {
                      "data": {
                        "value": "Example input"
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-client"
          }
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "activateElements": [
            {
              "elementId": "DelegateRequest",
              "variables": {
                "toolCall": {
                  "_meta": {
                    "id": "call-1",
                    "name": "DelegateRequest"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "elementSelectors": [
            {
              "elementId": "DelegateRequest"
            }
          ],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "completionConditionFulfilled": true,
          "variables": {
            "agent": {
              "responseText": "Done."
            }
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ]
}
