{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "processId": "a2a-card-dispute",
  "testCases": [
    {
      "name": "Agent calls the tool - agent result is returned",
      "description": "The agent runs the placeholder tool and finishes; the process ends with the agent result as its output.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "variables": {
            "req": {
              "message": {
                "parts": [
                  {
                    "data": {
                      "demoInput": {
                        "value": "Example input"
                      }
                    }
                  }
                ]
              }
            }
          }
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "AgentTools"
          },
          "activateElements": [
            {
              "elementId": "echo_placeholder",
              "variables": {
                "toolCall": {
                  "_meta": {
                    "id": "call-1",
                    "name": "echo_placeholder"
                  },
                  "requestData": {
                    "value": "Example input"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "elementSelectors": [
            {
              "elementId": "echo_placeholder"
            }
          ],
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "AgentTools"
          },
          "completionConditionFulfilled": true,
          "variables": {
            "agent": {
              "responseText": "Done.",
              "context": {
                "conversation": {
                  "messages": [
                    {
                      "role": "tool_call_result",
                      "results": [
                        {
                          "id": "call-1",
                          "name": "echo_placeholder",
                          "content": {
                            "value": "Example input"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "elementSelectors": [
            {
              "elementId": "AgentFinished"
            }
          ],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Request as JSON text part - the tool still receives demoInput",
      "description": "Clients that send only text (e.g. ADK-style) carry demoInput as JSON in a text part.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "variables": {
            "req": {
              "message": {
                "parts": [
                  {
                    "text": "{\"value\":\"Example input\"}"
                  }
                ]
              }
            }
          }
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "AgentTools"
          },
          "activateElements": [
            {
              "elementId": "echo_placeholder",
              "variables": {
                "toolCall": {
                  "_meta": {
                    "id": "call-1",
                    "name": "echo_placeholder"
                  },
                  "requestData": {
                    "value": "Example input"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "elementSelectors": [
            {
              "elementId": "echo_placeholder"
            }
          ],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-card-dispute"
          },
          "variables": {
            "toolCallResult": {
              "value": "Example input"
            }
          }
        }
      ]
    }
  ]
}
