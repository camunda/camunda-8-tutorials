    <bpmn:startEvent id="CardRequested" name="Agent Card requested" zeebe:modelerTemplate="dev.hansel.a2a.core.card.v1" zeebe:modelerTemplateVersion="4">
      <bpmn:documentation>The camunda-a2a-demo.example.com public RPC URL is a nonfunctional example. Replace it with the deployed HTTPS A2A RPC webhook URL before use; it must match the client's A2A_RPC_URL secret.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.context" value="a2a-card" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.responseExpression" value="={rpcUrl: get value(correlation.activatedElement.properties, &#34;inbound.publicRpcUrl&#34;), response: if rpcUrl instance of string and matches(rpcUrl, &#34;^https://[^ /]+/[^ ]*$&#34;) then {statusCode: 200, headers: {&#34;Content-Type&#34;: &#34;application/json&#34;}, body: {name: &#34;BPMN A2A skeleton&#34;, version: &#34;0.1.0&#34;, description: &#34;Non-production BPMN A2A skeleton. Returns a placeholder tool artifact.&#34;, provider: {organization: &#34;HanselIdes&#34;, url: &#34;https://github.com/HanselIdes/camunda-a2a&#34;}, supportedInterfaces: [{url: rpcUrl, protocolBinding: &#34;JSONRPC&#34;, protocolVersion: &#34;1.0&#34;}], capabilities: {streaming: false, pushNotifications: true, extendedAgentCard: false}, defaultInputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], defaultOutputModes: [&#34;text/plain&#34;, &#34;application/json&#34;], securitySchemes: {}, securityRequirements: [], skills: [{id: &#34;echo_placeholder&#34;, name: &#34;Echo placeholder&#34;, description: &#34;Call once to return the process-owned placeholder value. Accepts no model arguments. Replace this tool with your own business logic.&#34;, tags: [&#34;placeholder&#34;], examples: [&#34;Example input&#34;]}]}} else {statusCode: 500, body: {error: &#34;Configure the Agent Card HTTPS public RPC URL&#34;}}}.response" />
          <zeebe:property name="inbound.publicRpcUrl" value="https://camunda-a2a-demo.example.com/inbound/a2a" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CardRequested_CardServed</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CardRequested_message" messageRef="AgentCardRequestMessage" />
    </bpmn:startEvent>
    <bpmn:endEvent id="CardServed" name="Card served">
      <bpmn:incoming>Flow_CardRequested_CardServed</bpmn:incoming>
    </bpmn:endEvent>
