<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Collaboration_a2a_protocol" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="NotFound" name="NotFound" errorCode="NOT_FOUND" />
  <bpmn:process id="a2a-rpc" name="02 A2A Server" isExecutable="true">
    <bpmn:documentation>The A2A server endpoint. It accepts A2A 1.0 and 0.3 requests on one URL. For each new task it starts the agent process named by the secret A2A_AGENT_PROCESS, and it answers all other requests from the task's current state. Deploy it next to your agent process without changes.</bpmn:documentation>
    <bpmn:startEvent id="RpcReceived" name="A2A request received" zeebe:modelerTemplate="dev.hansel.a2a.core.rpc.v1" zeebe:modelerTemplateVersion="3">
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
          <zeebe:property name="synchronousResponse" value="true" />
          <zeebe:property name="consumeUnmatchedEvents" value="true" />
          <zeebe:property name="deduplicationModeManualFlag" value="false" />
          <zeebe:property name="deduplicationMode" value="AUTO" />
          <zeebe:property name="inbound.method" value="post" />
          <zeebe:property name="inbound.context" value="a2a" />
          <zeebe:property name="inbound.responseExpression" value="={&#10;  statusCode: 200,&#10;  headers: {&#34;Content-Type&#34;: &#34;application/json&#34;},&#10;  body: (&#10;    for resp in [correlation.variables.rpcResponse]&#10;    return&#10;      if resp = null or correlation.variables.dialect != &#34;0.3&#34; or resp.error != null&#10;      then resp&#10;      else (&#10;        for c in [&#10;          {&#10;            st: {&#10;              &#34;TASK_STATE_SUBMITTED&#34;: &#34;submitted&#34;,&#10;              &#34;TASK_STATE_WORKING&#34;: &#34;working&#34;,&#10;              &#34;TASK_STATE_INPUT_REQUIRED&#34;: &#34;input-required&#34;,&#10;              &#34;TASK_STATE_AUTH_REQUIRED&#34;: &#34;auth-required&#34;,&#10;              &#34;TASK_STATE_COMPLETED&#34;: &#34;completed&#34;,&#10;              &#34;TASK_STATE_CANCELED&#34;: &#34;canceled&#34;,&#10;              &#34;TASK_STATE_FAILED&#34;: &#34;failed&#34;,&#10;              &#34;TASK_STATE_REJECTED&#34;: &#34;rejected&#34;&#10;            },&#10;            part:&#10;              function(p)&#10;                if p.data != null&#10;                then {kind: &#34;data&#34;, data: p.data}&#10;                else if p.url != null&#10;                then {&#10;                  kind: &#34;file&#34;,&#10;                  file: context(&#10;                    get entries(&#10;                      {uri: p.url, mimeType: p.mediaType, name: p.filename}&#10;                    )[item.value != null]&#10;                  )&#10;                }&#10;                else if p.raw != null&#10;                then {&#10;                  kind: &#34;file&#34;,&#10;                  file: context(&#10;                    get entries(&#10;                      {bytes: p.raw, mimeType: p.mediaType, name: p.filename}&#10;                    )[item.value != null]&#10;                  )&#10;                }&#10;                else {kind: &#34;text&#34;, text: p.text},&#10;            msg:&#10;              function(m)&#10;                context(&#10;                  get entries(&#10;                    {&#10;                      kind: &#34;message&#34;,&#10;                      messageId: m.messageId,&#10;                      role: if m.role = &#34;ROLE_USER&#34; then &#34;user&#34; else &#34;agent&#34;,&#10;                      parts: for p in m.parts return part(p),&#10;                      taskId: m.taskId,&#10;                      contextId: m.contextId,&#10;                      metadata: m.metadata&#10;                    }&#10;                  )[item.value != null]&#10;                ),&#10;            task:&#10;              function(t)&#10;                context(&#10;                  get entries(&#10;                    {&#10;                      kind: &#34;task&#34;,&#10;                      id: t.id,&#10;                      contextId: t.contextId,&#10;                      status: context(&#10;                        get entries(&#10;                          {&#10;                            state: get value(st, t.status.state),&#10;                            timestamp: t.status.timestamp,&#10;                            message:&#10;                              if t.status.message != null then msg(t.status.message) else null&#10;                          }&#10;                        )[item.value != null]&#10;                      ),&#10;                      artifacts:&#10;                        for a in t.artifacts&#10;                        return context(&#10;                          get entries(&#10;                            {&#10;                              artifactId: a.artifactId,&#10;                              name: a.name,&#10;                              description: a.description,&#10;                              parts: for p in a.parts return part(p),&#10;                              metadata: a.metadata&#10;                            }&#10;                          )[item.value != null]&#10;                        ),&#10;                      history: for h in t.history return msg(h),&#10;                      metadata: t.metadata&#10;                    }&#10;                  )[item.value != null]&#10;                )&#10;          }&#10;        ]&#10;        return {&#10;          jsonrpc: resp.jsonrpc,&#10;          id: resp.id,&#10;          result:&#10;            if resp.result.message != null&#10;            then c.msg(resp.result.message)&#10;            else c.task(if resp.result.task != null then resp.result.task else resp.result)&#10;        }&#10;      )[1]&#10;  )[1]&#10;}" />
          <zeebe:property name="resultVariable" value="" />
          <zeebe:property name="resultExpression" value="={&#10;  rpc: request.body,&#10;  hdr: {&#10;    &#34;content-type&#34;: request.headers.`content-type`,&#10;    &#34;a2a-version&#34;: request.headers.`a2a-version`&#10;  },&#10;  pushEnabled: true&#10;}" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_RpcReceived_NormalizeRequest</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:scriptTask id="NormalizeRequest" name="Normalize request dialect">
      <bpmn:documentation>Converts A2A 0.3 requests (message/send, tasks/get, tasks/cancel) to the A2A 1.0 format so the rest of the process handles one format. A2A 1.0 requests pass through unchanged.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=(&#10;  for r in [if rpc instance of context then rpc else {}]&#10;  return for legacy in [r.method instance of string and contains(r.method, &#34;/&#34;)]&#10;  return for p in [if r.params instance of context then r.params else {}]&#10;  return for m in [if p.message instance of context then p.message else {}]&#10;  return for c in [if p.configuration instance of context then p.configuration else {}]&#10;  return {&#10;    dialect: if legacy then &#34;0.3&#34; else &#34;1.0&#34;,&#10;    hdr: if legacy then put(hdr, &#34;a2a-version&#34;, &#34;1.0&#34;) else hdr,&#10;    rpc:&#10;      if not(legacy)&#10;      then rpc&#10;      else put(&#10;        put(&#10;          r,&#10;          &#34;method&#34;,&#10;          if r.method = &#34;message/send&#34;&#10;          then &#34;SendMessage&#34;&#10;          else if r.method = &#34;tasks/get&#34;&#10;          then &#34;GetTask&#34;&#10;          else if r.method = &#34;tasks/cancel&#34; then &#34;CancelTask&#34; else r.method&#10;        ),&#10;        &#34;params&#34;,&#10;        if r.method = &#34;message/send&#34; and p.message instance of context&#10;        then put(&#10;          put(&#10;            p,&#10;            &#34;message&#34;,&#10;            put(&#10;              put(&#10;                m,&#10;                &#34;role&#34;,&#10;                if m.role = &#34;user&#34;&#10;                then &#34;ROLE_USER&#34;&#10;                else if m.role = &#34;agent&#34; then &#34;ROLE_AGENT&#34; else m.role&#10;              ),&#10;              &#34;parts&#34;,&#10;              if m.parts instance of list&#10;              then (&#10;                for q in m.parts&#10;                return&#10;                  if q instance of context and q.kind = &#34;data&#34;&#10;                  then {data: q.data}&#10;                  else if q instance of context and q.kind = &#34;file&#34;&#10;                  then context(&#10;                    get entries(&#10;                      {&#10;                        url: q.file.uri,&#10;                        raw: q.file.bytes,&#10;                        mediaType: q.file.mimeType,&#10;                        filename: q.file.name&#10;                      }&#10;                    )[item.value != null]&#10;                  )&#10;                  else if q instance of context then {text: q.text} else q&#10;              )&#10;              else m.parts&#10;            )&#10;          ),&#10;          &#34;configuration&#34;,&#10;          if p.configuration instance of context&#10;          then put(c, &#34;returnImmediately&#34;, c.blocking = false)&#10;          else p.configuration&#10;        )&#10;        else r.params&#10;      )&#10;  }&#10;)[1][1][1][1][1]" resultVariable="normalized" />
        <zeebe:ioMapping>
          <zeebe:output source="=normalized.rpc" target="rpc" />
          <zeebe:output source="=normalized.hdr" target="hdr" />
          <zeebe:output source="=normalized.dialect" target="dialect" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RpcReceived_NormalizeRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_NormalizeRequest_ParseRequest</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:scriptTask id="ParseRequest" name="Parse request">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  r: if rpc instance of context then rpc else {},&#10;  p: if r.params instance of context then r.params else {},&#10;  m: if p.message instance of context then p.message else {},&#10;  cfg: if p.configuration instance of context then p.configuration else {},&#10;  ct: get value(hdr, &#34;content-type&#34;),&#10;  ver: get value(hdr, &#34;a2a-version&#34;),&#10;  supported: [&#34;text/plain&#34;, &#34;application/json&#34;],&#10;  method: if r.method instance of string then r.method else null,&#10;  id: r.id,&#10;  versionOk: if ver instance of string then matches(ver, &#34;^1[.]0([.][0-9]+)?$&#34;) else false,&#10;  contentTypeOk:&#10;    if ct instance of string&#10;    then (&#10;      starts with(lower case(ct), &#34;application/json&#34;)&#10;        or starts with(lower case(ct), &#34;application/a2a+json&#34;)&#10;    )&#10;    else false,&#10;  jsonrpcOk: r.jsonrpc = &#34;2.0&#34; and method != null,&#10;  msgOk: p.message instance of context&#10;    and m.messageId instance of string&#10;    and m.role instance of string&#10;    and m.parts instance of list,&#10;  mediaOk:&#10;    if m.parts instance of list&#10;    then not(&#10;      some part in m.parts satisfies&#10;        part instance of context&#10;          and part.mediaType != null&#10;          and not(list contains(supported, part.mediaType))&#10;    )&#10;    else true,&#10;  pushMethods: [&#10;    &#34;CreateTaskPushNotificationConfig&#34;,&#10;    &#34;GetTaskPushNotificationConfig&#34;,&#10;    &#34;ListTaskPushNotificationConfigs&#34;,&#10;    &#34;DeleteTaskPushNotificationConfig&#34;&#10;  ],&#10;  pushRef:&#10;    if p.task_id instance of string&#10;    then p.task_id&#10;    else if p.taskId instance of string then p.taskId else null,&#10;  ref:&#10;    if method != null and list contains(pushMethods, method)&#10;    then pushRef&#10;    else if p.id instance of string then p.id else null,&#10;  idOk: ref instance of string and ref != &#34;&#34;,&#10;  pushEnabled: pushEnabled = true,&#10;  pushCfg: context(&#10;    get entries(&#10;      {id: p.id, url: p.url, token: p.token, authentication: p.authentication}&#10;    )[item.value != null]&#10;  ),&#10;  taskPush:&#10;    if cfg.taskPushNotificationConfig instance of context&#10;    then cfg.taskPushNotificationConfig&#10;    else if cfg.pushNotificationConfig instance of context&#10;    then {&#10;      url: cfg.pushNotificationConfig.url,&#10;      token: cfg.pushNotificationConfig.token,&#10;      authentication: {&#10;        scheme:&#10;          if cfg.pushNotificationConfig.authentication.schemes instance of list&#10;            and count(cfg.pushNotificationConfig.authentication.schemes) &#62; 0&#10;          then cfg.pushNotificationConfig.authentication.schemes[1]&#10;          else &#34;Bearer&#34;,&#10;        credentials: cfg.pushNotificationConfig.authentication.credentials&#10;      }&#10;    }&#10;    else null,&#10;  taskId: if m.taskId instance of string and m.taskId != &#34;&#34; then m.taskId else null,&#10;  contextId: if m.contextId instance of string and m.contextId != &#34;&#34; then m.contextId else null,&#10;  messageId: if m.messageId instance of string then m.messageId else null,&#10;  blocking: cfg.returnImmediately != true,&#10;  hl:&#10;    if cfg.historyLength instance of number&#10;    then cfg.historyLength&#10;    else if p.historyLength instance of number&#10;    then p.historyLength&#10;    else if p.history_length instance of number then p.history_length else null,&#10;  pageSize:&#10;    if p.pageSize instance of number&#10;    then p.pageSize&#10;    else if p.page_size instance of number then p.page_size else 50,&#10;  listContextId:&#10;    if p.contextId instance of string and p.contextId != &#34;&#34;&#10;    then p.contextId&#10;    else if p.context_id instance of string and p.context_id != &#34;&#34; then p.context_id else null,&#10;  listStatus: if p.status instance of string and p.status != &#34;&#34; then p.status else null,&#10;  listAfter:&#10;    if p.statusTimestampAfter instance of string&#10;    then p.statusTimestampAfter&#10;    else if p.status_timestamp_after instance of string then p.status_timestamp_after else null,&#10;  pageToken:&#10;    if p.pageToken instance of string&#10;    then p.pageToken&#10;    else if p.page_token instance of string then p.page_token else null,&#10;  includeArtifacts: p.includeArtifacts = true or p.include_artifacts = true&#10;}" resultVariable="ctx" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NormalizeRequest_ParseRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ParseRequest_ValidateRequest</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:businessRuleTask id="ValidateRequest" name="Validate request">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="a2a-validate" resultVariable="verdict" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParseRequest_ValidateRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_ValidateRequest_RouteRequest</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="RouteRequest" name="Route request" default="Flow_RouteRequest_PrepareLookup">
      <bpmn:incoming>Flow_ValidateRequest_RouteRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteRequest_BuildValidationError</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareList</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareNewTask</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteRequest_PrepareLookup</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ValidationErrorReady" name="Error response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={&#10;  jsonrpc: &#34;2.0&#34;,&#10;  id: ctx.id,&#10;  error:&#10;    if verdict.reason = null&#10;    then {code: verdict.code, message: verdict.message}&#10;    else {&#10;      code: verdict.code,&#10;      message: verdict.message,&#10;      data: [&#10;        {&#10;          &#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;,&#10;          reason: verdict.reason,&#10;          domain: &#34;a2a-protocol.org&#34;&#10;        }&#10;      ]&#10;    }&#10;}" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_BuildValidationError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareList" name="Prepare task list">
      <bpmn:extensionElements>
        <zeebe:script expression="=(&#10;  for s in [&#10;    if ctx.listContextId != null then replace(ctx.listContextId, &#34;[^A-Za-z0-9_:.-]&#34;, &#34;_&#34;) else &#34;&#34;&#10;  ]&#10;  return {&#10;    ctxTag:&#10;      if ctx.listContextId != null&#10;      then &#34;ctx-&#34; + (if string length(s) &#62; 90 then substring(s, 1, 90) else s)&#10;      else null,&#10;    size: if ctx.pageSize &#60; 1 then 50 else if ctx.pageSize &#62; 100 then 100 else ctx.pageSize,&#10;    start:&#10;      if ctx.pageToken != null and number(ctx.pageToken) != null then number(ctx.pageToken) else 0&#10;  }&#10;)[1]" resultVariable="listReq" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareList</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareList_CollectTaskList</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="TaskListReady" name="Task list ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for taskViews in [&#10;    if is defined(taskItems) and taskItems != null&#10;    then&#10;      for i in taskItems&#10;      return (&#10;        for task in [i.value]&#10;        return (&#10;          for h in [&#10;            if ctx.hl = null or ctx.hl &#62;= count(task.history)&#10;            then task.history&#10;            else if ctx.hl &#60;= 0 then [] else sublist(task.history, count(task.history) - ctx.hl + 1)&#10;          ]&#10;          return context(&#10;            get entries(&#10;              {&#10;                id: task.id,&#10;                contextId: task.contextId,&#10;                status: task.status,&#10;                artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null,&#10;                history: if count(h) &#62; 0 then h else null&#10;              }&#10;            )[item.value != null]&#10;          )&#10;        )[1]&#10;      )[1]&#10;    else []&#10;  ]&#10;  return (&#10;    for views in [&#10;      if is defined(taskViews) and taskViews != null then taskViews[item != null] else []&#10;    ]&#10;    return for found in [&#10;      sort(&#10;        views[&#10;          (ctx.listContextId = null or item.contextId = ctx.listContextId)&#10;            and (ctx.listStatus = null or item.status.state = ctx.listStatus)&#10;            and (ctx.listAfter = null or item.status.timestamp &#62; ctx.listAfter)&#10;        ],&#10;        function(a, b)&#10;          if a.status.timestamp = b.status.timestamp&#10;          then a.id &#62; b.id&#10;          else a.status.timestamp &#62; b.status.timestamp&#10;      )&#10;    ]&#10;    return for left in [count(found) - listReq.start]&#10;    return for page in [&#10;      if left &#60;= 0&#10;      then []&#10;      else sublist(found, listReq.start + 1, if left &#60; listReq.size then left else listReq.size)&#10;    ]&#10;    return {&#10;      jsonrpc: &#34;2.0&#34;,&#10;      id: ctx.id,&#10;      result: {&#10;        tasks:&#10;          for t in page&#10;          return&#10;            if ctx.includeArtifacts then t else context(get entries(t)[item.key != &#34;artifacts&#34;]),&#10;        nextPageToken:&#10;          if listReq.start + listReq.size &#60; count(found)&#10;          then string(listReq.start + listReq.size)&#10;          else &#34;&#34;,&#10;        pageSize: listReq.size,&#10;        totalSize: count(found)&#10;      }&#10;    }&#10;  )[1][1][1][1]&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListCollected_BuildTaskList</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="PrepareNewTask" name="Prepare new task">
      <bpmn:extensionElements>
        <zeebe:script expression="=(&#10;  for cid in [if ctx.contextId != null then ctx.contextId else uuid()]&#10;  return for s in [replace(cid, &#34;[^A-Za-z0-9_:.-]&#34;, &#34;_&#34;)]&#10;  return for tid in [uuid()]&#10;  return {&#10;    taskId: tid,&#10;    contextId: cid,&#10;    ctxTag: &#34;ctx-&#34; + (if string length(s) &#62; 90 then substring(s, 1, 90) else s),&#10;    task: {&#10;      id: tid,&#10;      contextId: cid,&#10;      rev: 1,&#10;      status: {state: &#34;TASK_STATE_WORKING&#34;, timestamp: substring(string(now()), 1, 19) + &#34;Z&#34;},&#10;      artifacts: [],&#10;      history: [put(put(ctx.m, &#34;taskId&#34;, tid), &#34;contextId&#34;, cid)]&#10;    },&#10;    push:&#10;      if ctx.pushEnabled and ctx.taskPush != null&#10;      then put(&#10;        put(put(ctx.taskPush, &#34;dialect&#34;, if dialect = &#34;0.3&#34; then &#34;0.3&#34; else &#34;1.0&#34;), &#34;taskId&#34;, tid),&#10;        &#34;id&#34;,&#10;        if ctx.taskPush.id instance of string then ctx.taskPush.id else uuid()&#10;      )&#10;      else null&#10;  }&#10;)[1][1][1]" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareNewTask</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareNewTask_DispatchJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="NewTaskReady" name="Task response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for task in [if seen != null then seen else lookup.task]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    result:&#10;      if task.responseMode = &#34;message&#34;&#10;        and task.status.state = &#34;TASK_STATE_COMPLETED&#34;&#10;        and task.status.message != null&#10;        and count(task.artifacts) = 0&#10;      then {message: task.status.message}&#10;      else (&#10;        for v in [&#10;          (&#10;            for h in [&#10;              if ctx.hl = null or ctx.hl &#62;= count(task.history)&#10;              then task.history&#10;              else if ctx.hl &#60;= 0&#10;              then []&#10;              else sublist(task.history, count(task.history) - ctx.hl + 1)&#10;            ]&#10;            return context(&#10;              get entries(&#10;                {&#10;                  id: task.id,&#10;                  contextId: task.contextId,&#10;                  status: task.status,&#10;                  artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null,&#10;                  history: if count(h) &#62; 0 then h else null&#10;                }&#10;              )[item.value != null]&#10;            )&#10;          )[1]&#10;        ]&#10;        return&#10;          if &#34;task&#34; = &#34;task&#34; then {task: v} else v&#10;      )[1]&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteOutcome_BuildNewTaskResponse</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="DispatchJoin">
      <bpmn:incoming>Flow_PrepareNewTask_DispatchJoin</bpmn:incoming>
      <bpmn:incoming>Flow_LinkDispatch_DispatchJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_DispatchJoin_Dispatch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:subProcess id="Dispatch" name="Hand over to the task and wait for its outcome">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=if lookup.task != null&#10;then lookup.task.id + &#34;:&#34; + string(lookup.task.rev + 1)&#10;else task.id + &#34;:&#34; + string(task.rev + 1)" target="awaitKey" />
          <zeebe:input source="=if ctx.method = &#34;CancelTask&#34; then &#34;PT5S&#34; else if ctx.blocking then &#34;PT20S&#34; else &#34;PT0S&#34;" target="wait" />
          <zeebe:input source="=null" target="settled" />
          <zeebe:input source="=null" target="correlated" />
          <zeebe:output source="=if settled != null then settled else task" target="seen" />
          <zeebe:output source="=settled != null" target="visible" />
          <zeebe:output source="=correlated" target="correlated" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DispatchJoin_Dispatch</bpmn:incoming>
      <bpmn:outgoing>Flow_Dispatch_RouteOutcome</bpmn:outgoing>
      <bpmn:startEvent id="Dispatch_Requested" name="Dispatch requested">
        <bpmn:outgoing>Dispatch_Flow_Requested_Fork</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:parallelGateway id="Dispatch_Fork" name="Subscribe and hand over">
        <bpmn:incoming>Dispatch_Flow_Requested_Fork</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_Fork_OutcomeFirst</bpmn:outgoing>
        <bpmn:outgoing>Dispatch_Flow_Fork_IsNew</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:eventBasedGateway id="Dispatch_OutcomeFirst" name="Outcome or time limit?">
        <bpmn:incoming>Dispatch_Flow_Fork_OutcomeFirst</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_OutcomeFirst_OutcomePublished</bpmn:outgoing>
        <bpmn:outgoing>Dispatch_Flow_OutcomeFirst_TimeLimit</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:intermediateCatchEvent id="Dispatch_OutcomePublished" name="Outcome published">
        <bpmn:incoming>Dispatch_Flow_OutcomeFirst_OutcomePublished</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_OutcomePublished_AwaitDone</bpmn:outgoing>
        <bpmn:signalEventDefinition id="Dispatch_OutcomePublished_def" signalRef="Signal_Settled" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="Dispatch_TimeLimit" name="Time limit reached">
        <bpmn:incoming>Dispatch_Flow_OutcomeFirst_TimeLimit</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_TimeLimit_AwaitDone</bpmn:outgoing>
        <bpmn:timerEventDefinition id="Dispatch_TimeLimit_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">=wait</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:exclusiveGateway id="Dispatch_AwaitDone">
        <bpmn:incoming>Dispatch_Flow_OutcomePublished_AwaitDone</bpmn:incoming>
        <bpmn:incoming>Dispatch_Flow_TimeLimit_AwaitDone</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_AwaitDone_Sync</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="Dispatch_IsNew" name="New task?" default="Dispatch_Flow_IsNew_CorrelateTask">
        <bpmn:incoming>Dispatch_Flow_Fork_IsNew</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_IsNew_CreateTask</bpmn:outgoing>
        <bpmn:outgoing>Dispatch_Flow_IsNew_CorrelateTask</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CreateTask" name="Start agent process" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="basic" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}&#34; + &#34;/v2/process-instances&#34;" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="={&#10;  processDefinitionId: &#34;a2a-task&#34;,&#10;  variables: {&#10;    task: lookup.task,&#10;    push: lookup.push,&#10;    req: {message: ctx.m, blocking: ctx.blocking, hl: ctx.hl}&#10;  },&#10;  tags: [&#34;a2a&#34;, &#34;task-&#34; + lookup.taskId, lookup.ctxTag]&#10;}" target="body" />
            <zeebe:input source="true" target="ignoreNullValues" />
            <zeebe:input source="{{secrets.ENGINE_USERNAME}}" target="authentication.username" />
            <zeebe:input source="{{secrets.ENGINE_PASSWORD}}" target="authentication.password" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={created: response.body.processInstanceKey}" />
            <zeebe:header key="errorExpression" value="=if string(error.code) = &#34;404&#34;&#10;then bpmnError(&#34;NOT_FOUND&#34;, &#34;not found&#34;)&#10;else if string(error.code) = &#34;409&#34; then bpmnError(&#34;CONFLICT&#34;, &#34;already exists&#34;) else null" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Dispatch_Flow_IsNew_CreateTask</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_CreateTask_TriggerDone</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:subProcess id="CorrelateTask" name="Hand message to the task">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=if ctx.method = &#34;CancelTask&#34; then &#34;a2a-cancel&#34; else &#34;a2a-send&#34;" target="messageName" />
            <zeebe:input source="=task.id" target="taskId" />
            <zeebe:input source="=3" target="tries" />
            <zeebe:input source="=if ctx.method = &#34;CancelTask&#34;&#10;then {}&#10;else {followUp: {message: ctx.m, blocking: ctx.blocking, hl: ctx.hl}}" target="payload" />
            <zeebe:input source="=null" target="attempt" />
            <zeebe:input source="=null" target="correlated" />
            <zeebe:output source="=correlated" target="correlated" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Dispatch_Flow_IsNew_CorrelateTask</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_CorrelateTask_Correlated</bpmn:outgoing>
        <bpmn:startEvent id="CorrelateTask_CorrelateRequested" name="Correlation requested">
          <bpmn:outgoing>CorrelateTask_Flow_CorrelateRequested_ResetAttempts</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:scriptTask id="CorrelateTask_ResetAttempts" name="Reset attempts">
          <bpmn:extensionElements>
            <zeebe:script expression="=0" resultVariable="attempt" />
          </bpmn:extensionElements>
          <bpmn:incoming>CorrelateTask_Flow_CorrelateRequested_ResetAttempts</bpmn:incoming>
          <bpmn:outgoing>CorrelateTask_Flow_ResetAttempts_TryJoin</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:exclusiveGateway id="CorrelateTask_TryJoin" name="Try correlation">
          <bpmn:incoming>CorrelateTask_Flow_ResetAttempts_TryJoin</bpmn:incoming>
          <bpmn:incoming>CorrelateTask_Flow_WaitBeforeRetry_TryJoin</bpmn:incoming>
          <bpmn:outgoing>CorrelateTask_Flow_TryJoin_CorrelateMessage</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="CorrelateTask_CorrelateMessage" name="Correlate message" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
            <zeebe:ioMapping>
              <zeebe:input source="basic" target="authentication.type" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}&#34; + &#34;/v2/messages/correlation&#34;" target="url" />
              <zeebe:input source="=false" target="followRedirects" />
              <zeebe:input source="JSON" target="documentReturnFormat.choice" />
              <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
              <zeebe:input source="=20" target="readTimeoutInSeconds" />
              <zeebe:input source="={name: messageName, correlationKey: taskId, variables: payload}" target="body" />
              <zeebe:input source="true" target="ignoreNullValues" />
              <zeebe:input source="{{secrets.ENGINE_USERNAME}}" target="authentication.username" />
              <zeebe:input source="{{secrets.ENGINE_PASSWORD}}" target="authentication.password" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="elementTemplateVersion" value="13" />
              <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
              <zeebe:header key="resultExpression" value="={}" />
              <zeebe:header key="errorExpression" value="=if string(error.code) = &#34;404&#34;&#10;then bpmnError(&#34;NOT_FOUND&#34;, &#34;not found&#34;)&#10;else if string(error.code) = &#34;409&#34; then bpmnError(&#34;CONFLICT&#34;, &#34;already exists&#34;) else null" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>CorrelateTask_Flow_TryJoin_CorrelateMessage</bpmn:incoming>
          <bpmn:outgoing>CorrelateTask_Flow_CorrelateMessage_MarkCorrelated</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:endEvent id="CorrelateTask_Correlated" name="Correlated">
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:output source="=true" target="correlated" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>CorrelateTask_Flow_CorrelateMessage_MarkCorrelated</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:scriptTask id="CorrelateTask_CountAttempt" name="Count attempt">
          <bpmn:extensionElements>
            <zeebe:script expression="=attempt + 1" resultVariable="attempt" />
          </bpmn:extensionElements>
          <bpmn:incoming>CorrelateTask_Flow_NoSubscription_CountAttempt</bpmn:incoming>
          <bpmn:outgoing>CorrelateTask_Flow_CountAttempt_AttemptsLeft</bpmn:outgoing>
        </bpmn:scriptTask>
        <bpmn:exclusiveGateway id="CorrelateTask_AttemptsLeft" name="Attempts left?" default="CorrelateTask_Flow_AttemptsLeft_MarkNotCorrelated">
          <bpmn:incoming>CorrelateTask_Flow_CountAttempt_AttemptsLeft</bpmn:incoming>
          <bpmn:outgoing>CorrelateTask_Flow_AttemptsLeft_WaitBeforeRetry</bpmn:outgoing>
          <bpmn:outgoing>CorrelateTask_Flow_AttemptsLeft_MarkNotCorrelated</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="CorrelateTask_WaitBeforeRetry" name="Wait before retry">
          <bpmn:incoming>CorrelateTask_Flow_AttemptsLeft_WaitBeforeRetry</bpmn:incoming>
          <bpmn:outgoing>CorrelateTask_Flow_WaitBeforeRetry_TryJoin</bpmn:outgoing>
          <bpmn:timerEventDefinition id="CorrelateTask_WaitBeforeRetry_def">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.3S"</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:intermediateCatchEvent>
        <bpmn:endEvent id="CorrelateTask_NotCorrelated" name="Not correlated">
          <bpmn:extensionElements>
            <zeebe:ioMapping>
              <zeebe:output source="=false" target="correlated" />
            </zeebe:ioMapping>
          </bpmn:extensionElements>
          <bpmn:incoming>CorrelateTask_Flow_AttemptsLeft_MarkNotCorrelated</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:boundaryEvent id="CorrelateTask_NoSubscription" name="No subscription yet" attachedToRef="CorrelateTask_CorrelateMessage">
          <bpmn:outgoing>CorrelateTask_Flow_NoSubscription_CountAttempt</bpmn:outgoing>
          <bpmn:errorEventDefinition id="CorrelateTask_NoSubscription_def" errorRef="NotFound" />
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="CorrelateTask_Flow_CorrelateRequested_ResetAttempts" sourceRef="CorrelateTask_CorrelateRequested" targetRef="CorrelateTask_ResetAttempts" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_ResetAttempts_TryJoin" sourceRef="CorrelateTask_ResetAttempts" targetRef="CorrelateTask_TryJoin" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_WaitBeforeRetry_TryJoin" sourceRef="CorrelateTask_WaitBeforeRetry" targetRef="CorrelateTask_TryJoin" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_TryJoin_CorrelateMessage" sourceRef="CorrelateTask_TryJoin" targetRef="CorrelateTask_CorrelateMessage" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_CorrelateMessage_MarkCorrelated" sourceRef="CorrelateTask_CorrelateMessage" targetRef="CorrelateTask_Correlated" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_NoSubscription_CountAttempt" sourceRef="CorrelateTask_NoSubscription" targetRef="CorrelateTask_CountAttempt" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_CountAttempt_AttemptsLeft" sourceRef="CorrelateTask_CountAttempt" targetRef="CorrelateTask_AttemptsLeft" />
        <bpmn:sequenceFlow id="CorrelateTask_Flow_AttemptsLeft_WaitBeforeRetry" name="yes" sourceRef="CorrelateTask_AttemptsLeft" targetRef="CorrelateTask_WaitBeforeRetry">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=attempt &lt; tries</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="CorrelateTask_Flow_AttemptsLeft_MarkNotCorrelated" name="no" sourceRef="CorrelateTask_AttemptsLeft" targetRef="CorrelateTask_NotCorrelated" />
      </bpmn:subProcess>
      <bpmn:exclusiveGateway id="Dispatch_Correlated" name="Task accepted it?" default="Dispatch_Flow_Correlated_NotHandled">
        <bpmn:incoming>Dispatch_Flow_CorrelateTask_Correlated</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_Correlated_TriggerDone</bpmn:outgoing>
        <bpmn:outgoing>Dispatch_Flow_Correlated_NotHandled</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="Dispatch_NotHandled" name="Task did not accept it">
        <bpmn:incoming>Dispatch_Flow_Correlated_NotHandled</bpmn:incoming>
        <bpmn:terminateEventDefinition id="Dispatch_NotHandled_def" />
      </bpmn:endEvent>
      <bpmn:exclusiveGateway id="Dispatch_TriggerDone">
        <bpmn:incoming>Dispatch_Flow_CreateTask_TriggerDone</bpmn:incoming>
        <bpmn:incoming>Dispatch_Flow_Correlated_TriggerDone</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_TriggerDone_Sync</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:parallelGateway id="Dispatch_Sync" name="Handed over and outcome known">
        <bpmn:incoming>Dispatch_Flow_AwaitDone_Sync</bpmn:incoming>
        <bpmn:incoming>Dispatch_Flow_TriggerDone_Sync</bpmn:incoming>
        <bpmn:outgoing>Dispatch_Flow_Sync_Done</bpmn:outgoing>
      </bpmn:parallelGateway>
      <bpmn:endEvent id="Dispatch_Done" name="Done">
        <bpmn:incoming>Dispatch_Flow_Sync_Done</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Dispatch_Flow_Requested_Fork" sourceRef="Dispatch_Requested" targetRef="Dispatch_Fork" />
      <bpmn:sequenceFlow id="Dispatch_Flow_Fork_OutcomeFirst" sourceRef="Dispatch_Fork" targetRef="Dispatch_OutcomeFirst" />
      <bpmn:sequenceFlow id="Dispatch_Flow_Fork_IsNew" sourceRef="Dispatch_Fork" targetRef="Dispatch_IsNew" />
      <bpmn:sequenceFlow id="Dispatch_Flow_OutcomeFirst_OutcomePublished" sourceRef="Dispatch_OutcomeFirst" targetRef="Dispatch_OutcomePublished" />
      <bpmn:sequenceFlow id="Dispatch_Flow_OutcomeFirst_TimeLimit" sourceRef="Dispatch_OutcomeFirst" targetRef="Dispatch_TimeLimit" />
      <bpmn:sequenceFlow id="Dispatch_Flow_OutcomePublished_AwaitDone" sourceRef="Dispatch_OutcomePublished" targetRef="Dispatch_AwaitDone" />
      <bpmn:sequenceFlow id="Dispatch_Flow_TimeLimit_AwaitDone" sourceRef="Dispatch_TimeLimit" targetRef="Dispatch_AwaitDone" />
      <bpmn:sequenceFlow id="Dispatch_Flow_AwaitDone_Sync" sourceRef="Dispatch_AwaitDone" targetRef="Dispatch_Sync" />
      <bpmn:sequenceFlow id="Dispatch_Flow_IsNew_CreateTask" name="yes" sourceRef="Dispatch_IsNew" targetRef="CreateTask">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=lookup.task != null</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Dispatch_Flow_IsNew_CorrelateTask" name="no" sourceRef="Dispatch_IsNew" targetRef="CorrelateTask" />
      <bpmn:sequenceFlow id="Dispatch_Flow_CreateTask_TriggerDone" sourceRef="CreateTask" targetRef="Dispatch_TriggerDone" />
      <bpmn:sequenceFlow id="Dispatch_Flow_CorrelateTask_Correlated" sourceRef="CorrelateTask" targetRef="Dispatch_Correlated" />
      <bpmn:sequenceFlow id="Dispatch_Flow_Correlated_TriggerDone" name="yes" sourceRef="Dispatch_Correlated" targetRef="Dispatch_TriggerDone">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=correlated = true</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Dispatch_Flow_Correlated_NotHandled" name="no" sourceRef="Dispatch_Correlated" targetRef="Dispatch_NotHandled" />
      <bpmn:sequenceFlow id="Dispatch_Flow_TriggerDone_Sync" sourceRef="Dispatch_TriggerDone" targetRef="Dispatch_Sync" />
      <bpmn:sequenceFlow id="Dispatch_Flow_Sync_Done" sourceRef="Dispatch_Sync" targetRef="Dispatch_Done" />
    </bpmn:subProcess>
    <bpmn:scriptTask id="PrepareLookup" name="Prepare lookup">
      <bpmn:extensionElements>
        <zeebe:script expression="={&#10;  taskId: if ctx.method = &#34;SendMessage&#34; then ctx.taskId else ctx.ref,&#10;  indexDeadline: string(now() + duration(&#34;PT3S&#34;))&#10;}" resultVariable="lookup" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteRequest_PrepareLookup</bpmn:incoming>
      <bpmn:outgoing>Flow_PrepareLookup_LookupJoin</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:serviceTask id="FindTask" name="Find task" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}&#34; + &#34;/v2/process-instances/search&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={filter: {processDefinitionId: &#34;a2a-task&#34;, tags: [&#34;task-&#34; + lookup.taskId]}, page: {limit: 1}}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="{{secrets.ENGINE_USERNAME}}" target="authentication.username" />
          <zeebe:input source="{{secrets.ENGINE_PASSWORD}}" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={found: if count(response.body.items) &#62; 0 then response.body.items[1].processInstanceKey else null}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &#34;404&#34;&#10;then bpmnError(&#34;NOT_FOUND&#34;, &#34;not found&#34;)&#10;else if string(error.code) = &#34;409&#34; then bpmnError(&#34;CONFLICT&#34;, &#34;already exists&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_LookupJoin_FindTask</bpmn:incoming>
      <bpmn:outgoing>Flow_FindTask_ReadTask</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TaskKnown" name="Task known?" default="Flow_TaskKnown_LookupTimeLeft">
      <bpmn:incoming>Flow_ReadTask_TaskKnown</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskKnown_RouteMethod</bpmn:outgoing>
      <bpmn:outgoing>Flow_TaskKnown_LookupTimeLeft</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="ReadTask" name="Read task" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="basic" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}&#34; + &#34;/v2/variables/search?truncateValues=false&#34;" target="url" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="JSON" target="documentReturnFormat.choice" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="={&#10;  filter: {&#10;    name: &#34;task&#34;,&#10;    processInstanceKey: if found != null then found else &#34;0&#34;,&#10;    scopeKey: if found != null then found else &#34;0&#34;&#10;  },&#10;  page: {limit: 1}&#10;}" target="body" />
          <zeebe:input source="true" target="ignoreNullValues" />
          <zeebe:input source="{{secrets.ENGINE_USERNAME}}" target="authentication.username" />
          <zeebe:input source="{{secrets.ENGINE_PASSWORD}}" target="authentication.password" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={task: if count(response.body.items) &#62; 0 then from json(response.body.items[1].value) else null}" />
          <zeebe:header key="errorExpression" value="=if string(error.code) = &#34;404&#34;&#10;then bpmnError(&#34;NOT_FOUND&#34;, &#34;not found&#34;)&#10;else if string(error.code) = &#34;409&#34; then bpmnError(&#34;CONFLICT&#34;, &#34;already exists&#34;) else null" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FindTask_ReadTask</bpmn:incoming>
      <bpmn:outgoing>Flow_ReadTask_TaskKnown</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="RouteMethod" name="Method" default="Flow_RouteMethod_NotFoundJoin">
      <bpmn:incoming>Flow_TaskKnown_RouteMethod</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteMethod_NotFoundJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteMethod_BuildTaskView</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteMethod_Cancelable</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteMethod_CheckFollowUp</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="NotFoundReady" name="Not found response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for e in [{code: -32001, message: &#34;Task not found&#34;, reason: &#34;TASK_NOT_FOUND&#34;}]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    error:&#10;      if e.reason = null&#10;      then {code: e.code, message: e.message}&#10;      else {&#10;        code: e.code,&#10;        message: e.message,&#10;        data: [&#10;          {&#10;            &#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;,&#10;            reason: e.reason,&#10;            domain: &#34;a2a-protocol.org&#34;&#10;          }&#10;        ]&#10;      }&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotFoundJoin_BuildNotFound</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="TaskViewReady" name="Task response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={&#10;  jsonrpc: &#34;2.0&#34;,&#10;  id: ctx.id,&#10;  result: (&#10;    for h in [&#10;      if ctx.hl = null or ctx.hl &#62;= count(task.history)&#10;      then task.history&#10;      else if ctx.hl &#60;= 0 then [] else sublist(task.history, count(task.history) - ctx.hl + 1)&#10;    ]&#10;    return context(&#10;      get entries(&#10;        {&#10;          id: task.id,&#10;          contextId: task.contextId,&#10;          status: task.status,&#10;          artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null,&#10;          history: if count(h) &#62; 0 then h else null&#10;        }&#10;      )[item.value != null]&#10;    )&#10;  )[1]&#10;}" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteMethod_BuildTaskView</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Cancelable" name="Cancelable?" default="Flow_Cancelable_NotCancelableJoin">
      <bpmn:incoming>Flow_RouteMethod_Cancelable</bpmn:incoming>
      <bpmn:outgoing>Flow_Cancelable_NotCancelableJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_Cancelable_DispatchJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CanceledReady" name="Cancel response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={&#10;  jsonrpc: &#34;2.0&#34;,&#10;  id: ctx.id,&#10;  result: (&#10;    for h in [&#10;      if null = null or null &#62;= count(seen.history)&#10;      then seen.history&#10;      else if null &#60;= 0 then [] else sublist(seen.history, count(seen.history) - null + 1)&#10;    ]&#10;    return context(&#10;      get entries(&#10;        {&#10;          id: seen.id,&#10;          contextId: seen.contextId,&#10;          status: seen.status,&#10;          artifacts: if count(seen.artifacts) &#62; 0 then seen.artifacts else null,&#10;          history: if count(h) &#62; 0 then h else null&#10;        }&#10;      )[item.value != null]&#10;    )&#10;  )[1]&#10;}" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CancellationOutcome_BuildCanceledView</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="NotCancelableReady" name="Not cancelable response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for e in [&#10;    {&#10;      code: -32002,&#10;      message: &#34;The task has already finished or cannot be canceled&#34;,&#10;      reason: &#34;TASK_NOT_CANCELABLE&#34;&#10;    }&#10;  ]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    error:&#10;      if e.reason = null&#10;      then {code: e.code, message: e.message}&#10;      else {&#10;        code: e.code,&#10;        message: e.message,&#10;        data: [&#10;          {&#10;            &#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;,&#10;            reason: e.reason,&#10;            domain: &#34;a2a-protocol.org&#34;&#10;          }&#10;        ]&#10;      }&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_NotCancelableJoin_BuildNotCancelable</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:scriptTask id="CheckFollowUp" name="Check follow-up">
      <bpmn:extensionElements>
        <zeebe:script expression="=if ctx.contextId != null and ctx.contextId != task.contextId&#10;then {code: -32602, message: &#34;contextId does not match the task&#34;}&#10;else if list contains(&#10;  [&#34;TASK_STATE_COMPLETED&#34;, &#34;TASK_STATE_CANCELED&#34;, &#34;TASK_STATE_FAILED&#34;, &#34;TASK_STATE_REJECTED&#34;],&#10;  task.status.state&#10;)&#10;then {&#10;  code: -32004,&#10;  message: &#34;Task is in a terminal state and cannot accept messages&#34;,&#10;  reason: &#34;UNSUPPORTED_OPERATION&#34;&#10;}&#10;else null" resultVariable="followError" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteMethod_CheckFollowUp</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckFollowUp_FollowUpAccepted</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="FollowUpAccepted" name="Accepted?" default="Flow_FollowUpAccepted_FollowUpErrorJoin">
      <bpmn:incoming>Flow_CheckFollowUp_FollowUpAccepted</bpmn:incoming>
      <bpmn:outgoing>Flow_FollowUpAccepted_DispatchJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_FollowUpAccepted_FollowUpErrorJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="RouteOutcome" name="Outcome" default="Flow_RouteOutcome_FollowUpErrorJoin">
      <bpmn:incoming>Flow_Dispatch_RouteOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_RouteOutcome_BuildNewTaskResponse</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteOutcome_CancellationOutcome</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteOutcome_BuildFollowUpResponse</bpmn:outgoing>
      <bpmn:outgoing>Flow_RouteOutcome_FollowUpErrorJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="FollowUpReady" name="Task response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for task in [if seen != null then seen else task]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    result:&#10;      if task.responseMode = &#34;message&#34;&#10;        and task.status.state = &#34;TASK_STATE_COMPLETED&#34;&#10;        and task.status.message != null&#10;        and count(task.artifacts) = 0&#10;      then {message: task.status.message}&#10;      else (&#10;        for v in [&#10;          (&#10;            for h in [&#10;              if ctx.hl = null or ctx.hl &#62;= count(task.history)&#10;              then task.history&#10;              else if ctx.hl &#60;= 0&#10;              then []&#10;              else sublist(task.history, count(task.history) - ctx.hl + 1)&#10;            ]&#10;            return context(&#10;              get entries(&#10;                {&#10;                  id: task.id,&#10;                  contextId: task.contextId,&#10;                  status: task.status,&#10;                  artifacts: if count(task.artifacts) &#62; 0 then task.artifacts else null,&#10;                  history: if count(h) &#62; 0 then h else null&#10;                }&#10;              )[item.value != null]&#10;            )&#10;          )[1]&#10;        ]&#10;        return&#10;          if &#34;task&#34; = &#34;task&#34; then {task: v} else v&#10;      )[1]&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_RouteOutcome_BuildFollowUpResponse</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="FollowUpErrorReady" name="Error response ready">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for e in [&#10;    if followError != null&#10;    then followError&#10;    else {code: -32004, message: &#34;Task is not waiting for input&#34;, reason: &#34;UNSUPPORTED_OPERATION&#34;}&#10;  ]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    error:&#10;      if e.reason = null&#10;      then {code: e.code, message: e.message}&#10;      else {&#10;        code: e.code,&#10;        message: e.message,&#10;        data: [&#10;          {&#10;            &#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;,&#10;            reason: e.reason,&#10;            domain: &#34;a2a-protocol.org&#34;&#10;          }&#10;        ]&#10;      }&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_FollowUpErrorJoin_BuildFollowUpError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RpcReceived_NormalizeRequest" sourceRef="RpcReceived" targetRef="NormalizeRequest" />
    <bpmn:sequenceFlow id="Flow_NormalizeRequest_ParseRequest" sourceRef="NormalizeRequest" targetRef="ParseRequest" />
    <bpmn:sequenceFlow id="Flow_ParseRequest_ValidateRequest" sourceRef="ParseRequest" targetRef="ValidateRequest" />
    <bpmn:sequenceFlow id="Flow_ValidateRequest_RouteRequest" sourceRef="ValidateRequest" targetRef="RouteRequest" />
    <bpmn:sequenceFlow id="Flow_RouteRequest_BuildValidationError" name="invalid" sourceRef="RouteRequest" targetRef="ValidationErrorReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.route = "error"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteRequest_PrepareList" name="list" sourceRef="RouteRequest" targetRef="PrepareList">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.route = "ListTasks"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteRequest_PrepareNewTask" name="new task" sourceRef="RouteRequest" targetRef="PrepareNewTask">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=verdict.route = "SendMessage" and ctx.taskId = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteRequest_PrepareLookup" name="task method" sourceRef="RouteRequest" targetRef="PrepareLookup" />
    <bpmn:sequenceFlow id="Flow_PrepareNewTask_DispatchJoin" sourceRef="PrepareNewTask" targetRef="DispatchJoin" />
    <bpmn:sequenceFlow id="Flow_FollowUpAccepted_DispatchJoin" name="yes" sourceRef="FollowUpAccepted" targetRef="Link_Dispatch_FromFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=followError = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Cancelable_DispatchJoin" name="active" sourceRef="Cancelable" targetRef="Link_Dispatch_FromCancel">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=not(list contains(["TASK_STATE_COMPLETED", "TASK_STATE_CANCELED", "TASK_STATE_FAILED", "TASK_STATE_REJECTED"], task.status.state))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_DispatchJoin_Dispatch" sourceRef="DispatchJoin" targetRef="Dispatch" />
    <bpmn:sequenceFlow id="Flow_Dispatch_RouteOutcome" sourceRef="Dispatch" targetRef="RouteOutcome" />
    <bpmn:sequenceFlow id="Flow_RouteOutcome_BuildNewTaskResponse" name="new task" sourceRef="RouteOutcome" targetRef="NewTaskReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ctx.method != "CancelTask" and lookup.task != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteOutcome_CancellationOutcome" name="cancel" sourceRef="RouteOutcome" targetRef="CancellationOutcome">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=ctx.method = "CancelTask"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteOutcome_BuildFollowUpResponse" name="follow-up handed over" sourceRef="RouteOutcome" targetRef="FollowUpReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=correlated = true and ctx.method != "CancelTask"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_FindTask_ReadTask" sourceRef="FindTask" targetRef="ReadTask" />
    <bpmn:sequenceFlow id="Flow_ReadTask_TaskKnown" sourceRef="ReadTask" targetRef="TaskKnown" />
    <bpmn:sequenceFlow id="Flow_TaskKnown_RouteMethod" name="yes" sourceRef="TaskKnown" targetRef="RouteMethod">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteMethod_NotFoundJoin" name="unsupported method" sourceRef="RouteMethod" targetRef="Link_NotFound_FromMethod" />
    <bpmn:sequenceFlow id="Flow_RouteMethod_BuildTaskView" name="GetTask" sourceRef="RouteMethod" targetRef="TaskViewReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null and ctx.method = "GetTask"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteMethod_Cancelable" name="CancelTask" sourceRef="RouteMethod" targetRef="Cancelable">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null and ctx.method = "CancelTask"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_RouteMethod_CheckFollowUp" name="SendMessage" sourceRef="RouteMethod" targetRef="CheckFollowUp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=task != null and ctx.method = "SendMessage"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_NotFoundJoin_BuildNotFound" sourceRef="Link_NotFound_Catch" targetRef="NotFoundReady" />
    <bpmn:sequenceFlow id="Flow_Cancelable_NotCancelableJoin" name="no" sourceRef="Cancelable" targetRef="Link_NotCancelable_FromCancelable" />
    <bpmn:sequenceFlow id="Flow_NotCancelableJoin_BuildNotCancelable" sourceRef="Link_NotCancelable_Catch" targetRef="NotCancelableReady" />
    <bpmn:sequenceFlow id="Flow_CheckFollowUp_FollowUpAccepted" sourceRef="CheckFollowUp" targetRef="FollowUpAccepted" />
    <bpmn:sequenceFlow id="Flow_FollowUpAccepted_FollowUpErrorJoin" name="no" sourceRef="FollowUpAccepted" targetRef="Link_FollowUpError_FromAccepted" />
    <bpmn:sequenceFlow id="Flow_RouteOutcome_FollowUpErrorJoin" name="no" sourceRef="RouteOutcome" targetRef="Link_FollowUpError_FromOutcome" />
    <bpmn:sequenceFlow id="Flow_FollowUpErrorJoin_BuildFollowUpError" sourceRef="Link_FollowUpError_Catch" targetRef="FollowUpErrorReady" />
    <bpmn:exclusiveGateway id="LookupTimeLeft" name="Time left for lookup?" default="Flow_LookupTimeLeft_NotFoundJoin">
      <bpmn:incoming>Flow_TaskKnown_LookupTimeLeft</bpmn:incoming>
      <bpmn:outgoing>Flow_LookupTimeLeft_WaitForIndex</bpmn:outgoing>
      <bpmn:outgoing>Flow_LookupTimeLeft_NotFoundJoin</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="LookupJoin">
      <bpmn:incoming>Flow_PrepareLookup_LookupJoin</bpmn:incoming>
      <bpmn:incoming>Flow_WaitForIndex_LookupJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_LookupJoin_FindTask</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="WaitForIndex" name="Await task index">
      <bpmn:incoming>Flow_LookupTimeLeft_WaitForIndex</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitForIndex_LookupJoin</bpmn:outgoing>
      <bpmn:timerEventDefinition id="WaitForIndex_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.25S"</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_PrepareLookup_LookupJoin" sourceRef="PrepareLookup" targetRef="LookupJoin" />
    <bpmn:sequenceFlow id="Flow_LookupJoin_FindTask" sourceRef="LookupJoin" targetRef="FindTask" />
    <bpmn:sequenceFlow id="Flow_TaskKnown_LookupTimeLeft" name="not readable yet" sourceRef="TaskKnown" targetRef="LookupTimeLeft" />
    <bpmn:sequenceFlow id="Flow_LookupTimeLeft_WaitForIndex" name="retry" sourceRef="LookupTimeLeft" targetRef="WaitForIndex">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=now() &lt; date and time(lookup.indexDeadline)</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_LookupTimeLeft_NotFoundJoin" name="expired" sourceRef="LookupTimeLeft" targetRef="Link_NotFound_FromLookup" />
    <bpmn:sequenceFlow id="Flow_WaitForIndex_LookupJoin" sourceRef="WaitForIndex" targetRef="LookupJoin" />
    <bpmn:exclusiveGateway id="CancellationOutcome" name="Terminal outcome visible?" default="Flow_CancellationOutcome_CancellationTimeout">
      <bpmn:incoming>Flow_RouteOutcome_CancellationOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_CancellationOutcome_BuildCanceledView</bpmn:outgoing>
      <bpmn:outgoing>Flow_CancellationOutcome_NotCancelableJoin</bpmn:outgoing>
      <bpmn:outgoing>Flow_CancellationOutcome_CancellationTimeout</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="CancellationErrorReady" name="Cancellation failed">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for e in [&#10;    {&#10;      code: -32603,&#10;      message: &#34;The cancellation result was not available in time&#34;,&#10;      reason: &#34;DEADLINE_EXCEEDED&#34;&#10;    }&#10;  ]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    error:&#10;      if e.reason = null&#10;      then {code: e.code, message: e.message}&#10;      else {&#10;        code: e.code,&#10;        message: e.message,&#10;        data: [&#10;          {&#10;            &#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;,&#10;            reason: e.reason,&#10;            domain: &#34;a2a-protocol.org&#34;&#10;          }&#10;        ]&#10;      }&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_CancellationOutcome_CancellationTimeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CancellationOutcome_BuildCanceledView" name="canceled" sourceRef="CancellationOutcome" targetRef="CanceledReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=visible and seen.status.state = "TASK_STATE_CANCELED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancellationOutcome_NotCancelableJoin" name="not canceled" sourceRef="CancellationOutcome" targetRef="Link_NotCancelable_FromCancellation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=seen != null and seen.status.state != "TASK_STATE_CANCELED" and ((visible and list contains(["TASK_STATE_COMPLETED", "TASK_STATE_CANCELED", "TASK_STATE_FAILED", "TASK_STATE_REJECTED"], seen.status.state)) or not(correlated))</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_CancellationOutcome_CancellationTimeout" name="not visible" sourceRef="CancellationOutcome" targetRef="CancellationErrorReady" />
    <bpmn:subProcess id="CollectTaskList" name="List all tasks">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:input source="=listReq" target="listReq" />
          <zeebe:input source="=null" target="listScan" />
          <zeebe:input source="=null" target="listing" />
          <zeebe:input source="=null" target="taskKeys" />
          <zeebe:input source="=null" target="listPage" />
          <zeebe:input source="=null" target="taskBatch" />
          <zeebe:output source="=listing.items" target="taskItems" />
          <zeebe:output source="=listing.failure" target="listFailure" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PrepareList_CollectTaskList</bpmn:incoming>
      <bpmn:outgoing>Flow_CollectTaskList_ListCollected</bpmn:outgoing>
      <bpmn:startEvent id="CollectTaskList_ListScanRequested" name="Collect tasks">
        <bpmn:outgoing>CollectTaskList_Flow_ListScanRequested_StartListScan</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:scriptTask id="CollectTaskList_StartListScan" name="Start listing">
        <bpmn:extensionElements>
          <zeebe:script expression="={items: [], keys: [], cursor: null, cursors: [], deadline: string(now() + duration(&#34;PT10S&#34;))}" resultVariable="listScan" />
        </bpmn:extensionElements>
        <bpmn:incoming>CollectTaskList_Flow_ListScanRequested_StartListScan</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_StartListScan_ListProcessPageJoin</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="CollectTaskList_ListProcessPageJoin">
        <bpmn:incoming>CollectTaskList_Flow_StartListScan_ListProcessPageJoin</bpmn:incoming>
        <bpmn:incoming>CollectTaskList_Flow_ListScanDecision_ListProcessPageJoin</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_ListProcessPageJoin_SearchTasks</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CollectTaskList_SearchTasks" name="Search next page of tasks" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="basic" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}&#34; + &#34;/v2/process-instances/search&#34;" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="={&#10;  filter: {&#10;    processDefinitionId: &#34;a2a-task&#34;,&#10;    tags: if listReq.ctxTag != null then [&#34;a2a&#34;, listReq.ctxTag] else [&#34;a2a&#34;]&#10;  },&#10;  sort: [{field: &#34;startDate&#34;, order: &#34;DESC&#34;}, {field: &#34;processInstanceKey&#34;, order: &#34;DESC&#34;}],&#10;  page: {limit: 100, after: listScan.cursor}&#10;}" target="body" />
            <zeebe:input source="true" target="ignoreNullValues" />
            <zeebe:input source="{{secrets.ENGINE_USERNAME}}" target="authentication.username" />
            <zeebe:input source="{{secrets.ENGINE_PASSWORD}}" target="authentication.password" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={&#10;  taskKeys: for i in response.body.items return i.processInstanceKey,&#10;  listPage: {count: count(response.body.items), cursor: response.body.page.endCursor}&#10;}" />
            <zeebe:header key="errorExpression" value="=if string(error.code) = &#34;404&#34;&#10;then bpmnError(&#34;NOT_FOUND&#34;, &#34;not found&#34;)&#10;else if string(error.code) = &#34;409&#34; then bpmnError(&#34;CONFLICT&#34;, &#34;already exists&#34;) else null" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>CollectTaskList_Flow_ListProcessPageJoin_SearchTasks</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_SearchTasks_AnyTasks</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="CollectTaskList_AnyTasks" name="Any tasks?" default="CollectTaskList_Flow_AnyTasks_ListBatchJoin">
        <bpmn:incoming>CollectTaskList_Flow_SearchTasks_AnyTasks</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_AnyTasks_ListVariablesJoin</bpmn:outgoing>
        <bpmn:outgoing>CollectTaskList_Flow_AnyTasks_ListBatchJoin</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:exclusiveGateway id="CollectTaskList_ListVariablesJoin">
        <bpmn:incoming>CollectTaskList_Flow_AnyTasks_ListVariablesJoin</bpmn:incoming>
        <bpmn:incoming>CollectTaskList_Flow_WaitListVariables_ListVariablesJoin</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_ListVariablesJoin_ReadTasks</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="CollectTaskList_ReadTasks" name="Read batch of task data" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="basic" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=&#34;{{secrets.ENGINE_URL}}&#34; + &#34;/v2/variables/search?truncateValues=false&#34;" target="url" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="JSON" target="documentReturnFormat.choice" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
            <zeebe:input source="={&#10;  filter: {name: &#34;task&#34;, processInstanceKey: {&#34;$in&#34;: taskKeys}, scopeKey: {&#34;$in&#34;: taskKeys}},&#10;  page: {limit: 100}&#10;}" target="body" />
            <zeebe:input source="true" target="ignoreNullValues" />
            <zeebe:input source="{{secrets.ENGINE_USERNAME}}" target="authentication.username" />
            <zeebe:input source="{{secrets.ENGINE_PASSWORD}}" target="authentication.password" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={taskBatch: for i in response.body.items return context merge([i, {value: from json(i.value)}])}" />
            <zeebe:header key="errorExpression" value="=if string(error.code) = &#34;404&#34;&#10;then bpmnError(&#34;NOT_FOUND&#34;, &#34;not found&#34;)&#10;else if string(error.code) = &#34;409&#34; then bpmnError(&#34;CONFLICT&#34;, &#34;already exists&#34;) else null" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>CollectTaskList_Flow_ListVariablesJoin_ReadTasks</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_ReadTasks_ListBatchJoin</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:exclusiveGateway id="CollectTaskList_ListBatchJoin">
        <bpmn:incoming>CollectTaskList_Flow_AnyTasks_ListBatchJoin</bpmn:incoming>
        <bpmn:incoming>CollectTaskList_Flow_ReadTasks_ListBatchJoin</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_ListBatchJoin_CollectListBatch</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="CollectTaskList_CollectListBatch" name="Validate and collect batch">
        <bpmn:extensionElements>
          <zeebe:script expression="=(&#10;  for ready in [&#10;    if count(taskKeys) = 0&#10;    then true&#10;    else taskBatch instance of list&#10;      and count(distinct values(taskKeys)) = count(taskKeys)&#10;      and count(taskBatch) = count(taskKeys)&#10;      and count(distinct values(taskBatch.scopeKey)) = count(taskKeys)&#10;      and (&#10;        every i in taskBatch satisfies&#10;          i.scopeKey = i.processInstanceKey&#10;            and list contains(taskKeys, i.scopeKey)&#10;            and i.value instance of context&#10;            and i.value.id instance of string&#10;            and i.value.contextId instance of string&#10;            and i.value.rev instance of number&#10;            and i.value.status instance of context&#10;            and i.value.status.state instance of string&#10;            and i.value.status.timestamp instance of string&#10;            and i.value.history instance of list&#10;            and i.value.artifacts instance of list&#10;      )&#10;  ]&#10;  return for overlap in [some k in taskKeys satisfies list contains(listScan.keys, k)]&#10;  return for nextOk in [&#10;    listPage.cursor instance of string&#10;      and listPage.cursor != &#34;&#34;&#10;      and not(list contains(listScan.cursors, listPage.cursor))&#10;  ]&#10;  return for action in [&#10;    if not(ready)&#10;    then (if now() &#62;= date and time(listScan.deadline) then &#34;deadline&#34; else &#34;variables&#34;)&#10;    else if overlap&#10;    then &#34;overlap&#34;&#10;    else if listPage.count &#60; 100&#10;    then &#34;done&#34;&#10;    else if listPage.count != 100 or not(nextOk)&#10;    then &#34;cursor&#34;&#10;    else if now() &#62;= date and time(listScan.deadline) then &#34;deadline&#34; else &#34;page&#34;&#10;  ]&#10;  return context merge(&#10;    [&#10;      listScan,&#10;      {&#10;        action: action,&#10;        items:&#10;          if ready and not(overlap) and count(taskKeys) &#62; 0&#10;          then concatenate(listScan.items, taskBatch)&#10;          else listScan.items,&#10;        keys: if ready then concatenate(listScan.keys, taskKeys) else listScan.keys,&#10;        cursor: if action = &#34;page&#34; then listPage.cursor else listScan.cursor,&#10;        cursors:&#10;          if action = &#34;page&#34; then append(listScan.cursors, listPage.cursor) else listScan.cursors&#10;      }&#10;    ]&#10;  )&#10;)[1][1][1][1]" resultVariable="listScan" />
        </bpmn:extensionElements>
        <bpmn:incoming>CollectTaskList_Flow_ListBatchJoin_CollectListBatch</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_CollectListBatch_ListScanDecision</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="CollectTaskList_ListScanDecision" name="Listing finished?" default="CollectTaskList_Flow_ListScanDecision_FailListScan">
        <bpmn:incoming>CollectTaskList_Flow_CollectListBatch_ListScanDecision</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_ListScanDecision_FinishListScan</bpmn:outgoing>
        <bpmn:outgoing>CollectTaskList_Flow_ListScanDecision_ListProcessPageJoin</bpmn:outgoing>
        <bpmn:outgoing>CollectTaskList_Flow_ListScanDecision_WaitListVariables</bpmn:outgoing>
        <bpmn:outgoing>CollectTaskList_Flow_ListScanDecision_FailListScan</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:scriptTask id="CollectTaskList_FinishListScan" name="Return complete collection">
        <bpmn:extensionElements>
          <zeebe:script expression="={items: listScan.items, failure: null}" resultVariable="listing" />
        </bpmn:extensionElements>
        <bpmn:incoming>CollectTaskList_Flow_ListScanDecision_FinishListScan</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_FinishListScan_ListResultJoin</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:exclusiveGateway id="CollectTaskList_ListResultJoin">
        <bpmn:incoming>CollectTaskList_Flow_FinishListScan_ListResultJoin</bpmn:incoming>
        <bpmn:incoming>CollectTaskList_Flow_FailListScan_ListResultJoin</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_ListResultJoin_ListScanReady</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:endEvent id="CollectTaskList_ListScanReady" name="Collection ready">
        <bpmn:incoming>CollectTaskList_Flow_ListResultJoin_ListScanReady</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:intermediateCatchEvent id="CollectTaskList_WaitListVariables" name="Wait for task data to be searchable">
        <bpmn:incoming>CollectTaskList_Flow_ListScanDecision_WaitListVariables</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_WaitListVariables_ListVariablesJoin</bpmn:outgoing>
        <bpmn:timerEventDefinition id="CollectTaskList_WaitListVariables_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">="PT0.25S"</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:scriptTask id="CollectTaskList_FailListScan" name="Fail incomplete list">
        <bpmn:extensionElements>
          <zeebe:script expression="={&#10;  items: [],&#10;  failure:&#10;    if listScan.action = &#34;deadline&#34;&#10;    then {&#10;      code: -32603,&#10;      message: &#34;The task list was not ready in time&#34;,&#10;      reason: &#34;DEADLINE_EXCEEDED&#34;&#10;    }&#10;    else {&#10;      code: -32603,&#10;      message: &#34;The task list could not be read completely&#34;,&#10;      reason: &#34;DATA_LOSS&#34;&#10;    }&#10;}" resultVariable="listing" />
        </bpmn:extensionElements>
        <bpmn:incoming>CollectTaskList_Flow_ListScanDecision_FailListScan</bpmn:incoming>
        <bpmn:outgoing>CollectTaskList_Flow_FailListScan_ListResultJoin</bpmn:outgoing>
      </bpmn:scriptTask>
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListScanRequested_StartListScan" sourceRef="CollectTaskList_ListScanRequested" targetRef="CollectTaskList_StartListScan" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_StartListScan_ListProcessPageJoin" sourceRef="CollectTaskList_StartListScan" targetRef="CollectTaskList_ListProcessPageJoin" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListProcessPageJoin_SearchTasks" sourceRef="CollectTaskList_ListProcessPageJoin" targetRef="CollectTaskList_SearchTasks" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_SearchTasks_AnyTasks" sourceRef="CollectTaskList_SearchTasks" targetRef="CollectTaskList_AnyTasks" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_AnyTasks_ListVariablesJoin" name="read" sourceRef="CollectTaskList_AnyTasks" targetRef="CollectTaskList_ListVariablesJoin">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=count(taskKeys) &gt; 0</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListVariablesJoin_ReadTasks" sourceRef="CollectTaskList_ListVariablesJoin" targetRef="CollectTaskList_ReadTasks" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_AnyTasks_ListBatchJoin" name="empty" sourceRef="CollectTaskList_AnyTasks" targetRef="CollectTaskList_ListBatchJoin" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ReadTasks_ListBatchJoin" sourceRef="CollectTaskList_ReadTasks" targetRef="CollectTaskList_ListBatchJoin" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListBatchJoin_CollectListBatch" sourceRef="CollectTaskList_ListBatchJoin" targetRef="CollectTaskList_CollectListBatch" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_CollectListBatch_ListScanDecision" sourceRef="CollectTaskList_CollectListBatch" targetRef="CollectTaskList_ListScanDecision" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListScanDecision_FinishListScan" name="complete" sourceRef="CollectTaskList_ListScanDecision" targetRef="CollectTaskList_FinishListScan">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listScan.action = "done"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListScanDecision_ListProcessPageJoin" name="next page" sourceRef="CollectTaskList_ListScanDecision" targetRef="CollectTaskList_ListProcessPageJoin">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listScan.action = "page"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListScanDecision_WaitListVariables" name="retry state" sourceRef="CollectTaskList_ListScanDecision" targetRef="CollectTaskList_WaitListVariables">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listScan.action = "variables"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="CollectTaskList_Flow_WaitListVariables_ListVariablesJoin" sourceRef="CollectTaskList_WaitListVariables" targetRef="CollectTaskList_ListVariablesJoin" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListScanDecision_FailListScan" name="incomplete" sourceRef="CollectTaskList_ListScanDecision" targetRef="CollectTaskList_FailListScan" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_FinishListScan_ListResultJoin" sourceRef="CollectTaskList_FinishListScan" targetRef="CollectTaskList_ListResultJoin" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_FailListScan_ListResultJoin" sourceRef="CollectTaskList_FailListScan" targetRef="CollectTaskList_ListResultJoin" />
      <bpmn:sequenceFlow id="CollectTaskList_Flow_ListResultJoin_ListScanReady" sourceRef="CollectTaskList_ListResultJoin" targetRef="CollectTaskList_ListScanReady" />
    </bpmn:subProcess>
    <bpmn:exclusiveGateway id="ListCollected" name="Complete task collection?" default="Flow_ListCollected_BuildListFailure">
      <bpmn:incoming>Flow_CollectTaskList_ListCollected</bpmn:incoming>
      <bpmn:outgoing>Flow_ListCollected_BuildTaskList</bpmn:outgoing>
      <bpmn:outgoing>Flow_ListCollected_BuildListFailure</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ListFailureReady" name="Listing failed">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=(&#10;  for e in [listFailure]&#10;  return {&#10;    jsonrpc: &#34;2.0&#34;,&#10;    id: ctx.id,&#10;    error:&#10;      if e.reason = null&#10;      then {code: e.code, message: e.message}&#10;      else {&#10;        code: e.code,&#10;        message: e.message,&#10;        data: [&#10;          {&#10;            &#34;@type&#34;: &#34;type.googleapis.com/google.rpc.ErrorInfo&#34;,&#10;            reason: e.reason,&#10;            domain: &#34;a2a-protocol.org&#34;&#10;          }&#10;        ]&#10;      }&#10;  }&#10;)[1]" target="rpcResponse" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ListCollected_BuildListFailure</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_PrepareList_CollectTaskList" sourceRef="PrepareList" targetRef="CollectTaskList" />
    <bpmn:sequenceFlow id="Flow_CollectTaskList_ListCollected" sourceRef="CollectTaskList" targetRef="ListCollected" />
    <bpmn:sequenceFlow id="Flow_ListCollected_BuildTaskList" name="complete" sourceRef="ListCollected" targetRef="TaskListReady">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=listFailure = null</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ListCollected_BuildListFailure" name="incomplete" sourceRef="ListCollected" targetRef="ListFailureReady" />
    <bpmn:startEvent id="CardRequested" name="Agent Card requested" zeebe:modelerTemplate="dev.hansel.a2a.core.card.v1" zeebe:modelerTemplateVersion="4">
      <bpmn:documentation>Replace the placeholder URL (camunda-a2a-demo.example.com) with the HTTPS URL of your deployed A2A webhook (your connectors URL followed by /inbound/a2a). Clients use this address to reach the server, so it must be reachable from them.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:properties>
          <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
          <zeebe:property name="inbound.context" value="a2a-card" />
          <zeebe:property name="inbound.auth.type" value="NONE" />
          <zeebe:property name="inbound.method" value="get" />
          <zeebe:property name="inbound.responseExpression" value="={&#10;  rpcUrl: get value(correlation.activatedElement.properties, &#34;inbound.publicRpcUrl&#34;),&#10;  response:&#10;    if rpcUrl instance of string and matches(rpcUrl, &#34;^https://[^ /]+/[^ ]*$&#34;)&#10;    then {&#10;      statusCode: 200,&#10;      headers: {&#34;Content-Type&#34;: &#34;application/json&#34;},&#10;      body: {&#10;        name: &#34;A2A blueprint agent&#34;,&#10;        url: rpcUrl,&#10;        protocolVersion: &#34;0.3.0&#34;,&#10;        preferredTransport: &#34;JSONRPC&#34;,&#10;        supportsAuthenticatedExtendedCard: false,&#10;        version: &#34;0.1.0&#34;,&#10;        description: &#34;Example agent from the Camunda A2A blueprint. Returns your request data with an uppercased copy and its length.&#34;,&#10;        provider: {organization: &#34;Camunda&#34;, url: &#34;https://github.com/camunda/camunda-8-tutorials/tree/main/solutions/a2a-async-blueprint&#34;},&#10;        supportedInterfaces: [{url: rpcUrl, protocolBinding: &#34;JSONRPC&#34;, protocolVersion: &#34;1.0&#34;}],&#10;        capabilities: {streaming: false, pushNotifications: true, extendedAgentCard: false},&#10;        defaultInputModes: [&#34;text/plain&#34;, &#34;application/json&#34;],&#10;        defaultOutputModes: [&#34;text/plain&#34;, &#34;application/json&#34;],&#10;        securitySchemes: {},&#10;        securityRequirements: [],&#10;        skills: [&#10;          {&#10;            id: &#34;upperCase&#34;,&#10;            name: &#34;Uppercase text&#34;,&#10;            description: &#34;Returns the request data with an uppercased copy and its length. Replace this skill with your own business logic.&#34;,&#10;            tags: [&#34;example&#34;],&#10;            examples: [&#34;Example input&#34;]&#10;          }&#10;        ]&#10;      }&#10;    }&#10;    else {statusCode: 500, body: {error: &#34;Set the Agent Card's public URL to your HTTPS webhook URL&#34;}}&#10;}.response" />
          <zeebe:property name="inbound.publicRpcUrl" value="https://camunda-a2a-demo.example.com/inbound/a2a" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_CardRequested_CardServed</bpmn:outgoing>
      <bpmn:messageEventDefinition id="CardRequested_message" messageRef="AgentCardRequestMessage" />
    </bpmn:startEvent>
    <bpmn:endEvent id="CardServed" name="Card served">
      <bpmn:incoming>Flow_CardRequested_CardServed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CardRequested_CardServed" sourceRef="CardRequested" targetRef="CardServed" />
    <bpmn:intermediateCatchEvent id="Link_NotFound_Catch" name="Not found">
      <bpmn:outgoing>Flow_NotFoundJoin_BuildNotFound</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_NotFound_Catch_def" name="NotFound" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Link_NotFound_FromMethod" name="Not found">
      <bpmn:incoming>Flow_RouteMethod_NotFoundJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_NotFound_FromMethod_def" name="NotFound" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_NotFound_FromLookup" name="Not found">
      <bpmn:incoming>Flow_LookupTimeLeft_NotFoundJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_NotFound_FromLookup_def" name="NotFound" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Link_NotCancelable_Catch" name="Not cancelable">
      <bpmn:outgoing>Flow_NotCancelableJoin_BuildNotCancelable</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_NotCancelable_Catch_def" name="NotCancelable" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Link_NotCancelable_FromCancelable" name="Not cancelable">
      <bpmn:incoming>Flow_Cancelable_NotCancelableJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_NotCancelable_FromCancelable_def" name="NotCancelable" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_NotCancelable_FromCancellation" name="Not cancelable">
      <bpmn:incoming>Flow_CancellationOutcome_NotCancelableJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_NotCancelable_FromCancellation_def" name="NotCancelable" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Link_FollowUpError_Catch" name="Follow-up error">
      <bpmn:outgoing>Flow_FollowUpErrorJoin_BuildFollowUpError</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_FollowUpError_Catch_def" name="FollowUpError" />
    </bpmn:intermediateCatchEvent>
    <bpmn:intermediateThrowEvent id="Link_FollowUpError_FromAccepted" name="Follow-up error">
      <bpmn:incoming>Flow_FollowUpAccepted_FollowUpErrorJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_FollowUpError_FromAccepted_def" name="FollowUpError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_FollowUpError_FromOutcome" name="Follow-up error">
      <bpmn:incoming>Flow_RouteOutcome_FollowUpErrorJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_FollowUpError_FromOutcome_def" name="FollowUpError" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateCatchEvent id="Link_Dispatch_In" name="Dispatch">
      <bpmn:outgoing>Flow_LinkDispatch_DispatchJoin</bpmn:outgoing>
      <bpmn:linkEventDefinition id="Link_Dispatch_In_def" name="Dispatch" />
    </bpmn:intermediateCatchEvent>
    <bpmn:sequenceFlow id="Flow_LinkDispatch_DispatchJoin" sourceRef="Link_Dispatch_In" targetRef="DispatchJoin" />
    <bpmn:intermediateThrowEvent id="Link_Dispatch_FromFollowUp" name="Dispatch">
      <bpmn:incoming>Flow_FollowUpAccepted_DispatchJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_Dispatch_FromFollowUp_def" name="Dispatch" />
    </bpmn:intermediateThrowEvent>
    <bpmn:intermediateThrowEvent id="Link_Dispatch_FromCancel" name="Dispatch">
      <bpmn:incoming>Flow_Cancelable_DispatchJoin</bpmn:incoming>
      <bpmn:linkEventDefinition id="Link_Dispatch_FromCancel_def" name="Dispatch" />
    </bpmn:intermediateThrowEvent>
      <bpmn:textAnnotation id="TextAnnotation_Purpose">
      <bpmn:text>Example 2. Receives A2A JSON-RPC requests, validates them, and answers SendMessage, GetTask, ListTasks and CancelTask by handing work to a task process and waiting for its outcome.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Purpose" associationDirection="None" sourceRef="RpcReceived" targetRef="TextAnnotation_Purpose" />
  </bpmn:process>
  <bpmn:signal id="Signal_Settled" name="=&#34;a2a-settled:&#34; + awaitKey" />
  <bpmn:message id="AgentCardRequestMessage" name="Agent Card request" />
  <bpmndi:BPMNDiagram id="BPMNDiagram_a2a-rpc">
    <bpmndi:BPMNPlane id="BPMNPlane_a2a-rpc" bpmnElement="a2a-rpc">
      <bpmndi:BPMNShape id="RpcReceived_di" bpmnElement="RpcReceived">
        <dc:Bounds x="162" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="150" y="108" width="61" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NormalizeRequest_di" bpmnElement="NormalizeRequest">
        <dc:Bounds x="277" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParseRequest_di" bpmnElement="ParseRequest">
        <dc:Bounds x="494" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidateRequest_di" bpmnElement="ValidateRequest">
        <dc:Bounds x="711" y="50" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RouteRequest_di" bpmnElement="RouteRequest" isMarkerVisible="true">
        <dc:Bounds x="953" y="65" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="943" y="35" width="70" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ValidationErrorReady_di" bpmnElement="ValidationErrorReady">
        <dc:Bounds x="1072" y="72" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1054" y="108" width="73" height="27" />
