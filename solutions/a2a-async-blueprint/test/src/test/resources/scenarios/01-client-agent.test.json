    {
      "name": "No callback - the deadline reports a timeout",
      "description": "Without a callback within ten minutes the tool call ends with a timeout result instead of waiting forever.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-client"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "FetchAgentCard"
          },
          "variables": {
            "agentCard": {
              "name": "Example A2A agent",
              "skills": [
                {
                  "id": "upper-case",
                  "name": "Upper case"
                }
              ]
            }
          }
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "activateElements": [
            {
              "elementId": "A2AClient",
              "variables": {
                "toolCall": {
                  "_meta": {
                    "id": "call-1",
                    "name": "A2AClient"
                  },
                  "operation": "sendMessage",
