{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "processId": "a2a-client",
  "testCases": [
    {
      "name": "Callback: the Task comes back first, then the authenticated callback delivers the result",
      "description": "Example 1. Send returns a submitted Task and the process keeps waiting without polling. The callback for the same task id and token completes the tool call.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-client"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "FetchAgentCard"
          },
          "variables": {
            "agentCard": {
              "name": "Example A2A agent",
              "skills": [
                {
                  "id": "upper-case",
                  "name": "Upper case"
                }
              ]
            }
          }
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "activateElements": [
            {
              "elementId": "A2AClient",
              "variables": {
                "toolCall": {
                  "_meta": {
                    "id": "call-1",
                    "name": "A2AClient"
                  },
                  "operation": "sendMessage",
                  "params": {
                    "text": "{\"value\":\"Example input\"}"
                  }
                }
              }
            }
          ]
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "A2AClient"
          },
          "variables": {
            "toolCallResult": {
              "result": {
                "kind": "task",
                "id": "remote-task-1",
                "contextId": "ctx-1",
                "status": {
                  "state": "submitted"
                }
              },
              "pushNotificationData": {
                "token": "a2a-client-callback"
              }
            }
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "elementSelector": {
            "elementId": "AwaitCallback"
          },
          "state": "IS_ACTIVE"
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "cf4a9562-6ffe-4810-b082-db16822578ff",
          "correlationKey": "remote-task-1-a2a-client-callback",
          "variables": {
            "toolCallResult": {
              "kind": "task",
              "id": "remote-task-1",
              "contextId": "ctx-1",
              "status": {
                "state": "completed"
              },
              "artifacts": [
                {
                  "artifactId": "a-1",
                  "parts": [
                    {
                      "data": {
                        "received": {
                          "value": "Example input"
                        },
                        "uppercase": "EXAMPLE INPUT",
                        "length": 13
                      }
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "elementSelector": {
            "elementId": "A2ATaskResult"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_JOB_AD_HOC_SUB_PROCESS",
          "jobSelector": {
            "elementId": "ClientAgent"
          },
          "completionConditionFulfilled": true,
          "variables": {
            "agent": {
              "responseText": "Done."
            }
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
