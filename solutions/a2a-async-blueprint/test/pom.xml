<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
    </parent>

    <groupId>io.camunda</groupId>
    <artifactId>a2a-async-blueprint-tests</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>A2A Async Blueprint — Process Tests</name>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <camunda.version>8.9.8</camunda.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.camunda</groupId>
            <artifactId>camunda-process-test-spring</artifactId>
            <version>${camunda.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-logging</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>../</directory>
                <includes>
                    <include>01-client-agent.bpmn</include>
                    <include>02-a2a-server.bpmn</include>
                    <include>server-request-validation.dmn</include>
                    <include>03-server-agent.bpmn</include>
                    <include>04-a2a-task.bpmn</include>
                </includes>
            </testResource>
            <!-- Test Studio scenarios live next to the BPMN; the Java suite runs them too. -->
            <testResource>
                <directory>../</directory>
                <targetPath>scenarios/01</targetPath>
                <includes>
                    <include>01-client-agent.test.json</include>
                </includes>
            </testResource>
            <testResource>
                <directory>../</directory>
                <targetPath>scenarios/02</targetPath>
                <includes>
                    <include>02-a2a-server.test.json</include>
                </includes>
            </testResource>
            <testResource>
                <directory>../</directory>
                <targetPath>scenarios/03</targetPath>
                <includes>
                    <include>03-server-agent.test.json</include>
                </includes>
            </testResource>
            <testResource>
                <directory>../</directory>
                <targetPath>scenarios/04</targetPath>
                <includes>
                    <include>04-a2a-task.test.json</include>
                </includes>
            </testResource>
        </testResources>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
            </plugin>
        </plugins>
    </build>
</project>
