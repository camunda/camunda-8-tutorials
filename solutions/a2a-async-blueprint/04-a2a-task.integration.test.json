{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.9/schema.json",
  "processId": "a2a-task",
  "testCases": [
    {
      "name": "Client did not offer push - the task settles without a push",
      "description": "When the client did not ask for push notifications, nothing is sent and the client reads the result with GetTask.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-task"
          },
          "startInstructions": [
            {
              "elementId": "PushConfigured"
            }
          ],
          "variables": {
            "task": {
              "id": "task-5",
              "contextId": "ctx-5",
              "rev": 1,
              "status": {
                "state": "TASK_STATE_COMPLETED"
              },
              "artifacts": [],
              "history": []
            }
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-task"
          },
          "elementSelectors": [
            {
              "elementId": "PublishOutcome"
            },
            {
              "elementId": "TaskSettled"
            }
          ],
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-task"
          },
          "elementSelectors": [
            {
              "elementId": "NotifyClient"
            }
          ],
          "state": "IS_NOT_ACTIVATED"
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-task"
          },
          "state": "IS_COMPLETED"
        }
      ]
    }
  ],
  "_integrationTestNotes": "Test Studio cannot mock connectors, the LLM or ad-hoc tool calls. These segments start at or after the routing logic and call no connector, so they run unchanged in Test Studio."
}
