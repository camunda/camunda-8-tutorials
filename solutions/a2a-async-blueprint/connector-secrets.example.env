# Copy to connector-secrets.env (gitignored) and fill in real values.
# c8run resolves {{secrets.FOO}} from SECRET_FOO. Load with:
#   set -a; source connector-secrets.env; set +a; c8ctl cluster start
SECRET_A2A_CALLBACK_URL=PLACEHOLDER
SECRET_A2A_CALLBACK_TOKEN=PLACEHOLDER
SECRET_A2A_REMOTE_SERVER_URL=PLACEHOLDER
SECRET_ENGINE_URL=PLACEHOLDER
SECRET_ENGINE_CLIENT_ID=PLACEHOLDER
SECRET_ENGINE_CLIENT_SECRET=PLACEHOLDER
# CAMUNDA_PROVIDED_LLM_* are shared by all local clusters: keep them in
# ~/.camunda/local-llm-secrets.env (outside any repo) and source it as well.
