# Local c8run only. Copy to connector-secrets.env (gitignored), then run:
#   c8run secrets import connector-secrets.env
A2A_AGENT_PROCESS=a2a-server-agent
A2A_CALLBACK_URL=http://localhost:8086/inbound/a2a-client-callback
A2A_CALLBACK_TOKEN=local-dev-token
A2A_REMOTE_SERVER_URL=http://localhost:8086/inbound/a2a-card
