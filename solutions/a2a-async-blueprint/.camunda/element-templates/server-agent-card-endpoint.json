{
  "$schema": "https://unpkg.com/@camunda/zeebe-element-templates-json-schema/resources/schema.json",
  "name": "Server - Agent Card Endpoint",
  "id": "dev.hansel.a2a.core.card.v1",
  "description": "Serves the Agent Card that tells other agents who you are and where to send A2A requests. Needs Camunda 8.9 or later with the standard connectors runtime. See the blueprint README for setup.",
  "documentationRef": "https://a2a-protocol.org/latest/specification/",
  "version": 4,
  "category": {
    "id": "connectors",
    "name": "Connectors"
  },
  "appliesTo": [
    "bpmn:StartEvent"
  ],
  "elementType": {
    "value": "bpmn:StartEvent"
  },
  "engines": {
    "camunda": "^8.9"
  },
  "groups": [
    {
      "id": "endpoint",
      "label": "Webhook"
    },
    {
      "id": "card",
      "label": "Agent Card"
    },
    {
      "id": "output",
      "label": "Output mapping"
    }
  ],
  "properties": [
    {
      "value": "io.camunda:webhook:1",
      "binding": {
        "name": "inbound.type",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.shouldValidateHmac",
      "value": "disabled",
      "binding": {
        "name": "inbound.shouldValidateHmac",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.auth.type",
      "value": "NONE",
      "binding": {
        "name": "inbound.auth.type",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "synchronousResponse",
      "value": "false",
      "binding": {
        "name": "synchronousResponse",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "consumeUnmatchedEvents",
      "value": "true",
      "binding": {
        "name": "consumeUnmatchedEvents",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "deduplicationModeManualFlag",
      "value": "false",
      "binding": {
        "name": "deduplicationModeManualFlag",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "deduplicationMode",
      "value": "AUTO",
      "binding": {
        "name": "deduplicationMode",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.method",
      "value": "get",
      "group": "endpoint",
      "binding": {
        "name": "inbound.method",
        "type": "zeebe:property"
      },
      "type": "Hidden"
    },
    {
      "id": "inbound.context",
      "label": "Webhook ID",
      "description": "Clients read the Agent Card from your connectors URL followed by /inbound/ and this ID.",
      "value": "a2a-card",
      "constraints": {
        "notEmpty": true
      },
      "feel": "optional",
      "group": "endpoint",
      "binding": {
        "name": "inbound.context",
        "type": "zeebe:property"
      },
      "type": "String"
    },
    {
      "id": "inbound.publicRpcUrl",
      "type": "String",
      "label": "Public RPC URL",
      "group": "card",
      "value": "",
      "description": "The full HTTPS URL of the A2A webhook, including the path (for example, https://example.com/inbound/a2a). Clients use it to send requests, so it must be reachable from them. It is public, not a credential.",
      "constraints": {
        "notEmpty": true,
        "pattern": {
          "value": "^https://[^ /]+/[^ ]*$",
          "message": "Enter the full HTTPS URL of the A2A webhook, including the path"
        }
      },
      "binding": {
        "type": "zeebe:property",
        "name": "inbound.publicRpcUrl"
      }
    },
    {
      "id": "inbound.responseExpression",
      "label": "Agent Card",
      "description": "Describes your agent to other agents. Update the name, description, and skills to match your agent. Keep the public URL field and the disabled capabilities.",
      "value": "={rpcUrl: get value(correlation.activatedElement.properties, \"inbound.publicRpcUrl\"), response: if rpcUrl instance of string and matches(rpcUrl, \"^https://[^ /]+/[^ ]*$\") then {statusCode: 200, headers: {\"Content-Type\": \"application/json\"}, body: {name: \"A2A blueprint agent\", version: \"0.1.0\", description: \"Example agent from the Camunda A2A blueprint. Returns your request data with an uppercased copy and its length.\", provider: {organization: \"Camunda\", url: \"https://github.com/camunda/camunda-8-tutorials/tree/main/solutions/a2a-async-blueprint\"}, supportedInterfaces: [{url: rpcUrl, protocolBinding: \"JSONRPC\", protocolVersion: \"1.0\"}], capabilities: {streaming: false, pushNotifications: true, extendedAgentCard: false}, defaultInputModes: [\"text/plain\", \"application/json\"], defaultOutputModes: [\"text/plain\", \"application/json\"], securitySchemes: {}, securityRequirements: [], skills: [{id: \"upperCase\", name: \"Uppercase text\", description: \"Returns the request data with an uppercased copy and its length. Replace this skill with your own business logic.\", tags: [\"example\"], examples: [\"Example input\"]}]}} else {statusCode: 500, body: {error: \"Set the Agent Card's public URL to your HTTPS webhook URL\"}}}.response",
      "feel": "required",
      "group": "card",
      "binding": {
        "name": "inbound.responseExpression",
        "type": "zeebe:property"
      },
      "type": "Text"
    },
    {
      "id": "resultVariable",
      "label": "Result variable",
      "description": "Name of variable to store the response in. Details in the <a href=\"https://docs.camunda.io/docs/8.9/components/connectors/use-connectors/#result-variable\" target=\"_blank\">documentation</a>.",
      "group": "output",
      "binding": {
        "name": "resultVariable",
        "type": "zeebe:property"
      },
      "type": "String"
    },
    {
      "id": "resultExpression",
      "label": "Result expression",
      "description": "Variable that holds the request data. Leave empty to skip.",
      "feel": "required",
      "group": "output",
      "binding": {
        "name": "resultExpression",
        "type": "zeebe:property"
      },
      "type": "Text"
    }
  ],
  "icon": {
    "contents": "data:image/svg+xml;base64,"
  }
}
