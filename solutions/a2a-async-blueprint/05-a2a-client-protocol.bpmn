<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_a2a_client_protocol" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="a2a-client-protocol" name="05 A2A Client - Protocol" isExecutable="true">
    <bpmn:startEvent id="DelegationStarted" name="Delegation started">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=0" target="pollCount" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_DelegationStarted_DiscoverAgentCard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="DiscoverAgentCard" name="Fetch remote agent card" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>Fetch the remote Agent Card to confirm the remote agent is reachable before sending.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="https://connectors.example.invalid" target="baseUrl" />
          <zeebe:input source="noAuth" target="authType" />
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="fetchAgentCard" target="operationId" />
          <zeebe:input source="inbound/a2a-card" target="agentCardLocation" />
          <zeebe:input source="=&#34;/&#34;+agentCardLocation" target="operationPath" />
          <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;}" target="headers" />
          <zeebe:input source="={}" target="queryParameters" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=true" target="ignoreNullValues" />
          <zeebe:input source="=if operationId != &#34;fetchAgentCard&#34; and rpcUrl != null then rpcUrl else baseUrl + operationPath" target="url" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={agentCard: response.body}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DelegationStarted_DiscoverAgentCard</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscoverAgentCard_SendA2AMessage</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="SendA2AMessage" name="Send A2A message (offer push)" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
            <zeebe:ioMapping>
              <zeebe:input source="https://connectors.example.invalid/inbound/a2a" target="baseUrl" />
              <zeebe:input source="noAuth" target="authType" />
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="sendMessage" target="operationId" />
              <zeebe:input source="a2a" target="rpcPath" />
              <zeebe:input source="=&#34;/&#34;+rpcPath" target="operationPath" />
              <zeebe:input source="={}" target="queryParameters" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=to json(requestData)" target="text" />
              <zeebe:input source="=null" target="taskId" />
              <zeebe:input source="=null" target="contextId" />
              <zeebe:input source="=[{text: text}, {data: {demoInput: requestData}}]" target="messageParts" />
              <zeebe:input source="=string(uuid())" target="pushToken" />
              <zeebe:input source="{{secrets.A2A_CALLBACK_SECRET}}" target="pushCredentials" />
              <zeebe:input source="=null" target="apiKey" />
              <zeebe:input source="=null" target="rpcUrl" />
              <zeebe:input source="=true" target="ignoreNullValues" />
              <zeebe:input source="=true" target="returnImmediately" />
              <zeebe:input source="https://connectors.example.invalid/inbound/a2a-push" target="webhookUrl" />
              <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;, &#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
              <zeebe:input source="=if operationId != &#34;fetchAgentCard&#34; and rpcUrl != null then rpcUrl else baseUrl + operationPath" target="url" />
              <zeebe:input source="={jsonrpc: &#34;2.0&#34;, id: string(uuid()), method: &#34;SendMessage&#34;, params: {message: {messageId: string(uuid()), role: &#34;ROLE_USER&#34;, parts: if messageParts != null then messageParts else [{text: text}], taskId: taskId, contextId: contextId}, configuration: {returnImmediately: if returnImmediately != null then returnImmediately else webhookUrl != null, taskPushNotificationConfig: if webhookUrl != null then {url: webhookUrl, token: pushToken, authentication: {scheme: &#34;Bearer&#34;, credentials: pushCredentials}} else null}}}" target="body" />
              <zeebe:output source="=remoteResponse" target="remoteResponse" />
              <zeebe:output source="=(for candidate in [if remoteResponse.result.task instance of context then remoteResponse.result.task else remoteResponse.result] return if candidate.id instance of string and candidate.contextId instance of string and candidate.status.state instance of string then candidate else null)[1]" target="acceptedTask" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={remoteResponse: response.body}" />
              <zeebe:header key="retryBackoff" value="PT0S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_DiscoverAgentCard_SendA2AMessage</bpmn:incoming>
          <bpmn:outgoing>Flow_SendA2AMessage_UpdateJoin</bpmn:outgoing>
        </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="TaskActive" name="Task still active?" default="Flow_TaskActive_ExtractResult">
      <bpmn:incoming>Flow_UpdateJoin_TaskActive</bpmn:incoming>
      <bpmn:outgoing>Flow_TaskActive_PushRace</bpmn:outgoing>
      <bpmn:outgoing>Flow_TaskActive_ExtractResult</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="AwaitPush" name="Push received" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnectorIntermediate.v1" zeebe:modelerTemplateVersion="10">
          <bpmn:extensionElements>
            <zeebe:properties>
              <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
              <zeebe:property name="inbound.method" value="post" />
              <zeebe:property name="inbound.context" value="a2a-push" />
              <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
              <zeebe:property name="inbound.auth.type" value="APIKEY" />
              <zeebe:property name="inbound.auth.apiKey" value="Bearer {{secrets.A2A_CALLBACK_SECRET}}" />
              <zeebe:property name="inbound.auth.apiKeyLocator" value="=get value(request.headers, &#34;authorization&#34;)" />
              <zeebe:property name="correlationKeyExpression" value="=request.body.task.id" />
              <zeebe:property name="resultVariable" value="" />
              <zeebe:property name="resultExpression" value="={remoteResponse: {result: {task: request.body.task}}, acceptedTask: request.body.task}" />
            </zeebe:properties>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_PushRace_AwaitPush</bpmn:incoming>
          <bpmn:outgoing>Flow_AwaitPush_UpdateJoin</bpmn:outgoing>
          <bpmn:messageEventDefinition id="AwaitPush_def" messageRef="Message_A2APush" />
        </bpmn:intermediateCatchEvent>
    <bpmn:eventBasedGateway id="PushRace" name="Push or poll">
      <bpmn:incoming>Flow_TaskActive_PushRace</bpmn:incoming>
      <bpmn:outgoing>Flow_PushRace_AwaitPush</bpmn:outgoing>
      <bpmn:outgoing>Flow_PushRace_PushTimeout</bpmn:outgoing>
    </bpmn:eventBasedGateway>
    <bpmn:intermediateCatchEvent id="PushTimeout" name="No push in 30 s">
      <bpmn:incoming>Flow_PushRace_PushTimeout</bpmn:incoming>
      <bpmn:outgoing>Flow_PushTimeout_GetTask</bpmn:outgoing>
      <bpmn:timerEventDefinition id="PushTimeout_def">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT30S</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="GetTask" name="Poll task (GetTask)" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>Polling fallback: read the task when no push arrived, or when the server did not accept the push config.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="https://connectors.example.invalid/inbound/a2a" target="baseUrl" />
          <zeebe:input source="noAuth" target="authType" />
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="getTask" target="operationId" />
          <zeebe:input source="a2a" target="rpcPath" />
          <zeebe:input source="=&#34;/&#34;+rpcPath" target="operationPath" />
          <zeebe:input source="={}" target="queryParameters" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=acceptedTask.id" target="taskId" />
          <zeebe:input source="=null" target="historyLength" />
          <zeebe:input source="=null" target="apiKey" />
          <zeebe:input source="=null" target="rpcUrl" />
          <zeebe:input source="=true" target="ignoreNullValues" />
          <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;, &#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
          <zeebe:input source="=if operationId != &#34;fetchAgentCard&#34; and rpcUrl != null then rpcUrl else baseUrl + operationPath" target="url" />
          <zeebe:input source="={jsonrpc: &#34;2.0&#34;, id: string(uuid()), method: &#34;GetTask&#34;, params: {id: taskId, historyLength: historyLength}}" target="body" />
          <zeebe:output source="=remoteResponse" target="remoteResponse" />
          <zeebe:output source="=(for candidate in [if remoteResponse.result.task instance of context then remoteResponse.result.task else remoteResponse.result] return if candidate.id = acceptedTask.id and candidate.status.state instance of string then candidate else acceptedTask)[1]" target="acceptedTask" />
          <zeebe:output source="=pollCount + 1" target="pollCount" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={remoteResponse: response.body}" />
          <zeebe:header key="retryBackoff" value="PT5S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PushTimeout_GetTask</bpmn:incoming>
      <bpmn:outgoing>Flow_GetTask_UpdateJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="UpdateJoin">
      <bpmn:incoming>Flow_SendA2AMessage_UpdateJoin</bpmn:incoming>
      <bpmn:incoming>Flow_AwaitPush_UpdateJoin</bpmn:incoming>
      <bpmn:incoming>Flow_GetTask_UpdateJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateJoin_TaskActive</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:scriptTask id="ExtractResult" name="Extract result">
      <bpmn:documentation>Works for any server: a completed Task yields its first artifact data part, otherwise all text parts joined.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:script expression="=if acceptedTask instance of context and acceptedTask.status.state = &#34;TASK_STATE_COMPLETED&#34; then (for parts in [flatten(for artifact in (if acceptedTask.artifacts instance of list then acceptedTask.artifacts else []) return artifact.parts)] return if count(parts[item.data != null]) &gt; 0 then parts[item.data != null][1].data else string join(for part in parts[item.text != null] return part.text, &#34;&#10;&#34;))[1] else null" resultVariable="delegationResult" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_TaskActive_ExtractResult</bpmn:incoming>
      <bpmn:outgoing>Flow_ExtractResult_DelegationFinished</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:endEvent id="DelegationFinished" name="Remote agent replied">
      <bpmn:incoming>Flow_ExtractResult_DelegationFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_DelegationStarted_DiscoverAgentCard" sourceRef="DelegationStarted" targetRef="DiscoverAgentCard" />
    <bpmn:sequenceFlow id="Flow_DiscoverAgentCard_SendA2AMessage" sourceRef="DiscoverAgentCard" targetRef="SendA2AMessage" />
    <bpmn:sequenceFlow id="Flow_SendA2AMessage_UpdateJoin" sourceRef="SendA2AMessage" targetRef="UpdateJoin" />
    <bpmn:sequenceFlow id="Flow_TaskActive_PushRace" name="yes" sourceRef="TaskActive" targetRef="PushRace">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if acceptedTask instance of context then list contains(["TASK_STATE_SUBMITTED", "TASK_STATE_WORKING"], acceptedTask.status.state) and pollCount &lt; 20 else false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_TaskActive_ExtractResult" name="no" sourceRef="TaskActive" targetRef="ExtractResult" />
    <bpmn:sequenceFlow id="Flow_ExtractResult_DelegationFinished" sourceRef="ExtractResult" targetRef="DelegationFinished" />
    <bpmn:sequenceFlow id="Flow_PushRace_AwaitPush" sourceRef="PushRace" targetRef="AwaitPush" />
    <bpmn:sequenceFlow id="Flow_PushRace_PushTimeout" sourceRef="PushRace" targetRef="PushTimeout" />
    <bpmn:sequenceFlow id="Flow_AwaitPush_UpdateJoin" sourceRef="AwaitPush" targetRef="UpdateJoin" />
    <bpmn:sequenceFlow id="Flow_PushTimeout_GetTask" sourceRef="PushTimeout" targetRef="GetTask" />
    <bpmn:sequenceFlow id="Flow_GetTask_UpdateJoin" sourceRef="GetTask" targetRef="UpdateJoin" />
    <bpmn:sequenceFlow id="Flow_UpdateJoin_TaskActive" sourceRef="UpdateJoin" targetRef="TaskActive" />
  </bpmn:process>
  <bpmn:message id="Message_A2APush" name="a2a-push" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnectorIntermediate.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=acceptedTask.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_a2a-client-protocol">
    <bpmndi:BPMNPlane id="BPMNPlane_a2a-client-protocol" bpmnElement="a2a-client-protocol">
      <bpmndi:BPMNShape id="DelegationStarted_di" bpmnElement="DelegationStarted">
        <dc:Bounds x="152" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="198" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DiscoverAgentCard_di" bpmnElement="DiscoverAgentCard">
        <dc:Bounds x="230" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SendA2AMessage_di" bpmnElement="SendA2AMessage">
        <dc:Bounds x="380" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateJoin_di" bpmnElement="UpdateJoin" isMarkerVisible="true">
        <dc:Bounds x="520" y="155" width="50" height="50" />
        
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="TaskActive_di" bpmnElement="TaskActive" isMarkerVisible="true">
        <dc:Bounds x="620" y="155" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="128" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExtractResult_di" bpmnElement="ExtractResult">
        <dc:Bounds x="720" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DelegationFinished_di" bpmnElement="DelegationFinished">
        <dc:Bounds x="870" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="852" y="198" width="72" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PushRace_di" bpmnElement="PushRace">
        <dc:Bounds x="720" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="712" y="362" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AwaitPush_di" bpmnElement="AwaitPush">
        <dc:Bounds x="820" y="262" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="225" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PushTimeout_di" bpmnElement="PushTimeout">
        <dc:Bounds x="820" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="800" y="425" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="GetTask_di" bpmnElement="GetTask">
        <dc:Bounds x="900" y="360" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_DelegationStarted_DiscoverAgentCard_di" bpmnElement="Flow_DelegationStarted_DiscoverAgentCard">
        <di:waypoint x="188" y="180" />
        <di:waypoint x="230" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DiscoverAgentCard_SendA2AMessage_di" bpmnElement="Flow_DiscoverAgentCard_SendA2AMessage">
        <di:waypoint x="330" y="180" />
        <di:waypoint x="380" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SendA2AMessage_UpdateJoin_di" bpmnElement="Flow_SendA2AMessage_UpdateJoin">
        <di:waypoint x="480" y="180" />
        <di:waypoint x="520" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_UpdateJoin_TaskActive_di" bpmnElement="Flow_UpdateJoin_TaskActive">
        <di:waypoint x="570" y="180" />
        <di:waypoint x="620" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskActive_ExtractResult_di" bpmnElement="Flow_TaskActive_ExtractResult">
        <di:waypoint x="670" y="180" />
        <di:waypoint x="720" y="180" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="688" y="158" width="13" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ExtractResult_DelegationFinished_di" bpmnElement="Flow_ExtractResult_DelegationFinished">
        <di:waypoint x="820" y="180" />
        <di:waypoint x="870" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_TaskActive_PushRace_di" bpmnElement="Flow_TaskActive_PushRace">
        <di:waypoint x="645" y="205" />
        <di:waypoint x="645" y="330" />
        <di:waypoint x="720" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="615" y="250" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PushRace_AwaitPush_di" bpmnElement="Flow_PushRace_AwaitPush">
        <di:waypoint x="745" y="305" />
        <di:waypoint x="745" y="280" />
        <di:waypoint x="820" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PushRace_PushTimeout_di" bpmnElement="Flow_PushRace_PushTimeout">
        <di:waypoint x="745" y="355" />
        <di:waypoint x="745" y="400" />
        <di:waypoint x="820" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AwaitPush_UpdateJoin_di" bpmnElement="Flow_AwaitPush_UpdateJoin">
        <di:waypoint x="856" y="280" />
        <di:waypoint x="1040" y="280" />
        <di:waypoint x="1040" y="100" />
        <di:waypoint x="545" y="100" />
        <di:waypoint x="545" y="155" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PushTimeout_GetTask_di" bpmnElement="Flow_PushTimeout_GetTask">
        <di:waypoint x="856" y="400" />
        <di:waypoint x="900" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_GetTask_UpdateJoin_di" bpmnElement="Flow_GetTask_UpdateJoin">
        <di:waypoint x="950" y="440" />
        <di:waypoint x="950" y="470" />
        <di:waypoint x="545" y="470" />
        <di:waypoint x="545" y="205" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
