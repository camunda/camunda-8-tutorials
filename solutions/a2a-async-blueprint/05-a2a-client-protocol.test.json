    {
      "name": "Send returns an error - the delegation ends with the error response",
      "description": "A JSON-RPC error carries no task, so the client stops and hands the error response back.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-client-protocol"
          },
          "variables": {
            "requestData": {
              "value": "Example input"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "DiscoverAgentCard"
          },
          "variables": {
            "agentCard": {
              "name": "Remote agent"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "SendA2AMessage"
          },
          "variables": {
            "remoteResponse": {
              "jsonrpc": "2.0",
              "id": "r",
              "error": {
                "code": -32602,
                "message": "Invalid params"
              }
            }
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client-protocol"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client-protocol"
          },
          "variables": {
            "remoteResponse": {
              "jsonrpc": "2.0",
              "id": "r",
              "error": {
                "code": -32602,
                "message": "Invalid params"
              }
            }
          }
        }
      ]
    },
    {
      "name": "External server returns a completed task with an unnamed text artifact",
      "description": "Terminal Task in the SendMessage response is final and the result is the joined text parts.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "a2a-client-protocol"
          },
          "variables": {
            "requestData": {
              "value": "Example input"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "DiscoverAgentCard"
          },
          "variables": {
            "agentCard": {
              "name": "Remote agent"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "SendA2AMessage"
          },
          "variables": {
            "remoteResponse": {
              "jsonrpc": "2.0",
              "id": "r",
              "result": {
                "task": {
                  "id": "demo-task",
                  "contextId": "demo-context",
                  "status": {
                    "state": "TASK_STATE_COMPLETED"
                  },
                  "artifacts": [
                    {
                      "artifactId": "a1",
                      "parts": [
                        {
                          "text": "Hello"
                        },
                        {
                          "text": "world"
                        }
                      ]
                    }
                  ]
                }
              }
            }
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client-protocol"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "a2a-client-protocol"
          },
          "variables": {
            "delegationResult": "Hello\nworld"
          }
        }
      ]
    },
    {
      "name": "External server returns an artifact with a data part",
      "description": "The first artifact data part wins over text parts, whatever the artifact name.",
