<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A2AClientConversation" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="a2a-client" name="01 A2A Client Agent" isExecutable="true">
    <bpmn:startEvent id="QuestionAsked" name="Start placeholder request">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={value: &#34;Example input&#34;}" target="demoInput" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_QuestionAsked_ClientAgent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="ClientAgent" name="Client AI agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openaiCompatible" target="provider.type" />
          <zeebe:input source="http://localhost:11434/v1" target="provider.openaiCompatible.endpoint" />
          <zeebe:input source="ollama" target="provider.openaiCompatible.authentication.apiKey" />
          <zeebe:input source="llama3.1:8b" target="provider.openaiCompatible.model.model" />
          <zeebe:input source="=0" target="provider.openaiCompatible.model.parameters.temperature" />
          <zeebe:input source="=&#34;You are a client agent. Use the remote agent tool to send the request below once as the message text, exactly as given. Never invent a result or claim completion unless the tool returned a completed task or a message with content. After receiving the result, briefly report it and finish. Do not request human input.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Send this request to the remote agent: &#34; + to json(demoInput)" target="data.userPrompt.prompt" />
          <zeebe:input source="=null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=true" target="data.response.includeAgentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="clientAgent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
        <zeebe:properties>
          <zeebe:property name="io.camunda.agenticai.toolContainer" value="true" />
        </zeebe:properties>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QuestionAsked_ClientAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientAgent_ClientConversationFinished</bpmn:outgoing>
      <bpmn:serviceTask id="A2AClient" name="Remote A2A agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.a2a.client.v0" zeebe:modelerTemplateVersion="0" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Talks to the remote A2A agent: fetches its Agent Card or sends it a message. The remote server returns the task right away and later calls the callback URL with the result.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda.agenticai:a2aclient:0" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="http://localhost:8086/inbound/" target="data.connection.url" />
            <zeebe:input source="a2a-card" target="data.connection.agentCardLocation" />
            <zeebe:input source="aiAgentTool" target="data.connectorMode.type" />
            <zeebe:input source="=toolCall.operation" target="data.connectorMode.toolOperation.operation" />
            <zeebe:input source="=toolCall.params" target="data.connectorMode.toolOperation.params" />
            <zeebe:input source="notification" target="data.connectorMode.toolOperation.sendMessageSettings.responseRetrievalMode.type" />
            <zeebe:input source="http://localhost:8086/inbound/a2a-client-callback" target="data.connectorMode.toolOperation.sendMessageSettings.responseRetrievalMode.webhookUrl" />
            <zeebe:input source="a2a-client-callback" target="data.connectorMode.toolOperation.sendMessageSettings.responseRetrievalMode.token" />
            <zeebe:input source="=[&#34;Bearer&#34;]" target="data.connectorMode.toolOperation.sendMessageSettings.responseRetrievalMode.authenticationSchemes" />
            <zeebe:input source="local-dev-token" target="data.connectorMode.toolOperation.sendMessageSettings.responseRetrievalMode.credentials" />
            <zeebe:input source="=3" target="data.connectorMode.toolOperation.sendMessageSettings.historyLength" />
            <zeebe:input source="PT1M" target="data.connectorMode.toolOperation.sendMessageSettings.timeout" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.a2a.client.v0" />
            <zeebe:header key="resultVariable" value="a2aClientResponse" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
          <zeebe:properties>
            <zeebe:property name="io.camunda.agenticai.gateway.type" value="a2aClient" />
          </zeebe:properties>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_A2AClient_SettledCheck</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_A2AClient_SettledCheck" sourceRef="A2AClient" targetRef="SettledCheck" />
      <bpmn:exclusiveGateway id="SettledCheck" name="Task still running?" default="Flow_SettledCheck_UseImmediateResult">
        <bpmn:incoming>Flow_A2AClient_SettledCheck</bpmn:incoming>
        <bpmn:outgoing>Flow_SettledCheck_AwaitCallback</bpmn:outgoing>
        <bpmn:outgoing>Flow_SettledCheck_UseImmediateResult</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:sequenceFlow id="Flow_SettledCheck_AwaitCallback" name="yes" sourceRef="SettledCheck" targetRef="AwaitCallback">
        <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=is defined(a2aClientResponse.result.status.state) and list contains(["submitted", "working"], a2aClientResponse.result.status.state)</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="Flow_SettledCheck_UseImmediateResult" name="no: final Task or Message" sourceRef="SettledCheck" targetRef="UseImmediateResult" />
      <bpmn:scriptTask id="UseImmediateResult" name="Use immediate result">
        <bpmn:documentation>The server already returned a final Task or a Message, so no callback will follow. The response is handed to the agent as is.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:script expression="=a2aClientResponse.result" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_SettledCheck_UseImmediateResult</bpmn:incoming>
      </bpmn:scriptTask>
      <bpmn:eventBasedGateway id="AwaitCallback" name="Callback or deadline?">
        <bpmn:incoming>Flow_SettledCheck_AwaitCallback</bpmn:incoming>
        <bpmn:outgoing>Flow_AwaitCallback_A2ATaskResult</bpmn:outgoing>
        <bpmn:outgoing>Flow_AwaitCallback_CallbackDeadline</bpmn:outgoing>
      </bpmn:eventBasedGateway>
      <bpmn:sequenceFlow id="Flow_AwaitCallback_A2ATaskResult" sourceRef="AwaitCallback" targetRef="A2ATaskResult" />
      <bpmn:sequenceFlow id="Flow_AwaitCallback_CallbackDeadline" sourceRef="AwaitCallback" targetRef="CallbackDeadline" />
      <bpmn:intermediateCatchEvent id="A2ATaskResult" name="Result callback received" zeebe:modelerTemplate="io.camunda.connectors.agenticai.a2a.client.webhook.intermediate.v0" zeebe:modelerTemplateVersion="1" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Authenticated callback from the remote server. Matches the task id and notification token, ignores non-final states, and drops duplicates.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:properties>
            <zeebe:property name="inbound.type" value="io.camunda.agenticai:a2aclient:webhook:0" />
            <zeebe:property name="inbound.context" value="a2a-client-callback" />
            <zeebe:property name="inbound.clientResponse" value="=internal_clientResponse" />
            <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
            <zeebe:property name="inbound.auth.type" value="APIKEY" />
            <zeebe:property name="inbound.auth.apiKey" value="local-dev-token" />
            <zeebe:property name="inbound.auth.apiKeyLocator" value="=split(request.headers.authorization, &#34; &#34;)[2]" />
            <zeebe:property name="activationCondition" value="=is defined(request.body.status.state) and not(list contains([&#34;submitted&#34;, &#34;working&#34;], request.body.status.state))" />
            <zeebe:property name="correlationKeyExpression" value="=request.body.id + (if is defined(request.headers.`x-a2a-notification-token`) then (&#34;-&#34; + request.headers.`x-a2a-notification-token`) else &#34;&#34;)" />
            <zeebe:property name="messageIdExpression" value="=request.body.id + &#34;-&#34; + request.body.status.state" />
            <zeebe:property name="deduplicationModeManualFlag" value="false" />
            <zeebe:property name="deduplicationMode" value="AUTO" />
            <zeebe:property name="resultVariable" value="" />
            <zeebe:property name="resultExpression" value="={toolCallResult: request.body}" />
          </zeebe:properties>
          <zeebe:ioMapping>
            <zeebe:input source="=a2aClientResponse" target="internal_clientResponse" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_AwaitCallback_A2ATaskResult</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_Callback" messageRef="Message_A2ACallback" />
      </bpmn:intermediateCatchEvent>
      <bpmn:intermediateCatchEvent id="CallbackDeadline" name="No callback in 10 minutes">
        <bpmn:incoming>Flow_AwaitCallback_CallbackDeadline</bpmn:incoming>
        <bpmn:outgoing>Flow_CallbackDeadline_ReportTimeout</bpmn:outgoing>
        <bpmn:timerEventDefinition id="CallbackDeadline_def">
          <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT10M</bpmn:timeDuration>
        </bpmn:timerEventDefinition>
      </bpmn:intermediateCatchEvent>
      <bpmn:sequenceFlow id="Flow_CallbackDeadline_ReportTimeout" sourceRef="CallbackDeadline" targetRef="ReportTimeout" />
      <bpmn:scriptTask id="ReportTimeout" name="Report timeout">
        <bpmn:extensionElements>
          <zeebe:script expression="={error: &#34;timeout&#34;, message: &#34;The remote agent did not call back in time.&#34;, taskId: a2aClientResponse.result.id}" resultVariable="toolCallResult" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_CallbackDeadline_ReportTimeout</bpmn:incoming>
      </bpmn:scriptTask>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="ClientConversationFinished" name="Client agent finished">
      <bpmn:incoming>Flow_ClientAgent_ClientConversationFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_QuestionAsked_ClientAgent" sourceRef="QuestionAsked" targetRef="ClientAgent" />
    <bpmn:sequenceFlow id="Flow_ClientAgent_ClientConversationFinished" sourceRef="ClientAgent" targetRef="ClientConversationFinished" />
    <bpmn:textAnnotation id="TextAnnotation_Purpose">
      <bpmn:text>Example 1. A client agent delegates a request to a remote A2A agent through the native A2A Client connector and returns the agent result when the remote agent calls back. The request returns a Task right away; nothing is polled.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Purpose" associationDirection="None" sourceRef="QuestionAsked" targetRef="TextAnnotation_Purpose" />
  </bpmn:process>
  <bpmn:message id="Message_A2ACallback" name="cf4a9562-6ffe-4810-b082-db16822578ff" zeebe:modelerTemplate="io.camunda.connectors.agenticai.a2a.client.webhook.intermediate.v0">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=a2aClientResponse.result.id + (if is defined(a2aClientResponse.pushNotificationData.token) then (&#34;-&#34; + a2aClientResponse.pushNotificationData.token) else &#34;&#34;)" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_a2a-client">
    <bpmndi:BPMNPlane id="BPMNPlane_a2a-client" bpmnElement="a2a-client">
      <bpmndi:BPMNShape id="QuestionAsked_di" bpmnElement="QuestionAsked">
        <dc:Bounds x="152" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="128" y="348" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientAgent_di" bpmnElement="ClientAgent" isExpanded="true">
        <dc:Bounds x="410" y="200" width="640" height="310" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2AClient_di" bpmnElement="A2AClient">
        <dc:Bounds x="450" y="290" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SettledCheck_di" bpmnElement="SettledCheck" isMarkerVisible="true">
        <dc:Bounds x="585" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="566" y="362" width="88" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AwaitCallback_di" bpmnElement="AwaitCallback">
        <dc:Bounds x="675" y="305" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="672" y="275" width="56" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0rtfkf8_di" bpmnElement="A2ATaskResult">
        <dc:Bounds x="792" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="773" y="355" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CallbackDeadline_di" bpmnElement="CallbackDeadline">
        <dc:Bounds x="792" y="412" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="768" y="455" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReportTimeout_di" bpmnElement="ReportTimeout">
        <dc:Bounds x="890" y="390" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UseImmediateResult_di" bpmnElement="UseImmediateResult">
        <dc:Bounds x="890" y="220" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A2AClient_SettledCheck_di" bpmnElement="Flow_A2AClient_SettledCheck">
        <di:waypoint x="550" y="330" />
        <di:waypoint x="585" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SettledCheck_AwaitCallback_di" bpmnElement="Flow_SettledCheck_AwaitCallback">
        <di:waypoint x="635" y="330" />
        <di:waypoint x="675" y="330" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="641" y="313" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_SettledCheck_UseImmediateResult_di" bpmnElement="Flow_SettledCheck_UseImmediateResult">
        <di:waypoint x="610" y="305" />
        <di:waypoint x="610" y="250" />
        <di:waypoint x="890" y="250" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="671" y="233" width="179" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AwaitCallback_A2ATaskResult_di" bpmnElement="Flow_AwaitCallback_A2ATaskResult">
        <di:waypoint x="725" y="330" />
        <di:waypoint x="792" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_AwaitCallback_CallbackDeadline_di" bpmnElement="Flow_AwaitCallback_CallbackDeadline">
        <di:waypoint x="700" y="355" />
        <di:waypoint x="700" y="430" />
        <di:waypoint x="792" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CallbackDeadline_ReportTimeout_di" bpmnElement="Flow_CallbackDeadline_ReportTimeout">
        <di:waypoint x="828" y="430" />
        <di:waypoint x="890" y="430" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ClientConversationFinished_di" bpmnElement="ClientConversationFinished">
        <dc:Bounds x="1112" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1101" y="348" width="59" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_Purpose_di" bpmnElement="Association_Purpose">
        <di:waypoint x="170" y="312" />
        <di:waypoint x="170" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_QuestionAsked_ClientAgent_di" bpmnElement="Flow_QuestionAsked_ClientAgent">
        <di:waypoint x="188" y="330" />
        <di:waypoint x="410" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClientAgent_ClientConversationFinished_di" bpmnElement="Flow_ClientAgent_ClientConversationFinished">
        <di:waypoint x="1050" y="330" />
        <di:waypoint x="1112" y="330" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="TextAnnotation_Purpose_di" bpmnElement="TextAnnotation_Purpose">
        <dc:Bounds x="128" y="90" width="400" height="90" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
