<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_A2AClientConversation" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="a2a-client" name="01 Client Agent - A2A Skeleton" isExecutable="true">
    <bpmn:startEvent id="QuestionAsked" name="Start placeholder request">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={value: &#34;Example input&#34;}" target="demoInput" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_QuestionAsked_ClientAgent</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="ClientAgent" name="Client AI agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openaiCompatible" target="provider.type" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT}}" target="provider.openaiCompatible.endpoint" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_KEY}}" target="provider.openaiCompatible.authentication.apiKey" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL}}" target="provider.openaiCompatible.model.model" />
          <zeebe:input source="=0" target="provider.openaiCompatible.model.parameters.temperature" />
          <zeebe:input source="=&#34;You run a minimal BPMN A2A skeleton. Use the remote A2A agent tool: first fetch the Agent Card, then send the request below once as the message text, exactly as given. Never invent a result or claim completion unless the tool returned a completed task or a message with content. After receiving the result, briefly report it and finish. Do not request human input.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Send this request to the remote agent: &#34; + to json(demoInput)" target="data.userPrompt.prompt" />
          <zeebe:input source="=null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="clientAgent" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QuestionAsked_ClientAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientAgent_ClientConversationFinished</bpmn:outgoing>
      <bpmn:serviceTask id="A2AClient" name="Remote A2A agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.a2a.client.v0" zeebe:modelerTemplateVersion="0" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:documentation>Talk to the remote A2A agent: fetch its Agent Card, or send it a message. Polling is used to wait for a task that is not yet finished.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda.agenticai:a2aclient:0" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="{{secrets.A2A_REMOTE_SERVER_URL}}" target="data.connection.url" />
            <zeebe:input source="aiAgentTool" target="data.connectorMode.type" />
            <zeebe:input source="=toolCall.operation" target="data.connectorMode.toolOperation.operation" />
            <zeebe:input source="=toolCall.params" target="data.connectorMode.toolOperation.params" />
            <zeebe:input source="polling" target="data.connectorMode.toolOperation.sendMessageSettings.responseRetrievalMode.type" />
            <zeebe:input source="=3" target="data.connectorMode.toolOperation.sendMessageSettings.historyLength" />
            <zeebe:input source="PT1M" target="data.connectorMode.toolOperation.sendMessageSettings.timeout" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="0" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.a2a.client.v0" />
            <zeebe:header key="resultVariable" value="toolCallResult" />
            <zeebe:header key="retryBackoff" value="PT30S" />
          </zeebe:taskHeaders>
          <zeebe:properties>
            <zeebe:property name="io.camunda.agenticai.gateway.type" value="a2aClient" />
          </zeebe:properties>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_A2AClient_A2ATaskResult</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_A2AClient_A2ATaskResult" sourceRef="A2AClient" targetRef="A2ATaskResult" />
      <bpmn:intermediateCatchEvent id="A2ATaskResult" name="Remote task settled" zeebe:modelerTemplate="io.camunda.connectors.agenticai.a2a.client.polling.intermediate.v0" zeebe:modelerTemplateVersion="0" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=toolCallResult" target="internal_clientResponse" />
          </zeebe:ioMapping>
          <zeebe:properties>
            <zeebe:property name="inbound.type" value="io.camunda.agenticai:a2aclient:polling:0" />
            <zeebe:property name="data.connection.url" value="{{secrets.A2A_REMOTE_SERVER_URL}}" />
            <zeebe:property name="data.clientResponse" value="=internal_clientResponse" />
            <zeebe:property name="data.historyLength" value="3" />
            <zeebe:property name="data.processPollingInterval" value="PT5S" />
            <zeebe:property name="data.taskPollingInterval" value="PT10S" />
            <zeebe:property name="activationCondition" value="=if result.kind = &#34;task&#34; then&#10;  is defined(result.status.state) and not(list contains([&#34;submitted&#34;, &#34;working&#34;], result.status.state))&#10;else&#10;  true" />
            <zeebe:property name="correlationKeyExpression" value="=pollingData.id" />
            <zeebe:property name="deduplicationModeManualFlag" value="false" />
            <zeebe:property name="deduplicationMode" value="AUTO" />
            <zeebe:property name="resultVariable" value="" />
            <zeebe:property name="resultExpression" value="={toolCallResult: result}" />
          </zeebe:properties>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_A2AClient_A2ATaskResult</bpmn:incoming>
        <bpmn:messageEventDefinition id="MessageEventDefinition_1pdfhzw" messageRef="Message_1jg1r6d" />
      </bpmn:intermediateCatchEvent>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="ClientConversationFinished" name="Client agent finished">
      <bpmn:incoming>Flow_ClientAgent_ClientConversationFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_QuestionAsked_ClientAgent" sourceRef="QuestionAsked" targetRef="ClientAgent" />
    <bpmn:sequenceFlow id="Flow_ClientAgent_ClientConversationFinished" sourceRef="ClientAgent" targetRef="ClientConversationFinished" />
  </bpmn:process>
  <bpmn:message id="Message_1jg1r6d" name="cf4a9562-6ffe-4810-b082-db16822578ff" zeebe:modelerTemplate="io.camunda.connectors.agenticai.a2a.client.polling.intermediate.v0">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=internal_clientResponse.pollingData.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_a2a-client">
    <bpmndi:BPMNPlane id="BPMNPlane_a2a-client" bpmnElement="a2a-client">
      <bpmndi:BPMNShape id="QuestionAsked_di" bpmnElement="QuestionAsked">
        <dc:Bounds x="152" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="130" y="198" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientAgent_di" bpmnElement="ClientAgent" isExpanded="true">
        <dc:Bounds x="250" y="80" width="400" height="200" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2AClient_di" bpmnElement="A2AClient">
        <dc:Bounds x="290" y="140" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_0rtfkf8_di" bpmnElement="A2ATaskResult">
        <dc:Bounds x="472" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="445" y="205" width="90" height="20" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_A2AClient_A2ATaskResult_di" bpmnElement="Flow_A2AClient_A2ATaskResult">
        <di:waypoint x="390" y="180" />
        <di:waypoint x="472" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="ClientConversationFinished_di" bpmnElement="ClientConversationFinished">
        <dc:Bounds x="712" y="162" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="693" y="198" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_QuestionAsked_ClientAgent_di" bpmnElement="Flow_QuestionAsked_ClientAgent">
        <di:waypoint x="188" y="180" />
        <di:waypoint x="250" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ClientAgent_ClientConversationFinished_di" bpmnElement="Flow_ClientAgent_ClientConversationFinished">
        <di:waypoint x="650" y="180" />
        <di:waypoint x="712" y="180" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
