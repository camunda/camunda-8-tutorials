<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_A2AClientConversation" targetNamespace="http://bpmn.io/schema/bpmn" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="A2ARequestFailed" name="A2ARequestFailed" errorCode="A2ARequestFailed" />
  <bpmn:process id="a2a-client" name="01 Client Agent - A2A Skeleton" isExecutable="true">
    <bpmn:startEvent id="QuestionAsked" name="Start placeholder request">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="={value: &#34;Example input&#34;}" target="demoInput" />
          <zeebe:output source="=null" target="clientAgent" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_QuestionAsked_DiscoverAgentCard</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="DiscoverAgentCard" name="Fetch remote agent card" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:documentation>Discover the remote process capabilities before entering the client AI agent.</bpmn:documentation>
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="https://connectors.example.invalid" target="baseUrl" />
          <zeebe:input source="noAuth" target="authType" />
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="fetchAgentCard" target="operationId" />
          <zeebe:input source="inbound/a2a-card" target="agentCardLocation" />
          <zeebe:input source="=&#34;/&#34;+agentCardLocation" target="operationPath" />
          <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;}" target="headers" />
          <zeebe:input source="={}" target="queryParameters" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=true" target="ignoreNullValues" />
          <zeebe:input source="=if operationId != &#34;fetchAgentCard&#34; and rpcUrl != null then rpcUrl else baseUrl + operationPath" target="url" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="resultExpression" value="={agentCard: response.body, toolCallResult: response.body}" />
          <zeebe:header key="retryBackoff" value="PT30S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_QuestionAsked_DiscoverAgentCard</bpmn:incoming>
      <bpmn:outgoing>Flow_DiscoverAgentCard_ClientAgent</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:adHocSubProcess id="ClientAgent" name="Client AI agent" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="5" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="1" />
        <zeebe:ioMapping>
          <zeebe:input source="openaiCompatible" target="provider.type" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_ENDPOINT}}" target="provider.openaiCompatible.endpoint" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_API_KEY}}" target="provider.openaiCompatible.authentication.apiKey" />
          <zeebe:input source="{{secrets.CAMUNDA_PROVIDED_LLM_DEFAULT_MODEL}}" target="provider.openaiCompatible.model.model" />
          <zeebe:input source="=0" target="provider.openaiCompatible.model.parameters.temperature" />
          <zeebe:input source="=&#34;You run a minimal BPMN A2A skeleton. The process has fetched the remote Agent Card. Call DelegateRequest to delegate the predefined request to that agent. The tool supplies the process-owned demoInput, sends a message, and polls the task. It accepts no model-provided data or task identifiers. Calling it while the last accepted task is submitted or working resumes waiting without resending. Its response is the actual JSON-RPC reply; task retains the last successful observation. Do not treat retained task data as a successful poll when response contains an error. Never invent a result or claim completion without TASK_STATE_COMPLETED and a returned artifact. After receiving the result, briefly report it and finish. Do not request human input.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Delegate Example input. Remote agent: &#34; + agentCard.name + &#34;\nSkills: &#34; + string join(agentCard.skills.name, &#34;, &#34;)" target="data.userPrompt.prompt" />
          <zeebe:input source="=null" target="agentContext" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=8" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="true" target="data.response.includeAgentContext" />
          <zeebe:output source="=agent" target="clientAgent" />
          <zeebe:output source="=(for records in [flatten( for message in agent.context.conversation.messages[item.role = &#34;tool_call_result&#34;] return message.results[item.name = &#34;DelegateRequest&#34;] )] return if count(records) &#62; 0 then (for content in [if records[count(records)].content instance of list then records[count(records)].content[item.type = &#34;object&#34;][1].content else records[count(records)].content] return if content instance of context and get value(content, &#34;toolCallResult&#34;) instance of context then content.toolCallResult else content)[1] else null)[1]" target="remoteResult" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="5" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={&#10;  id: toolCall._meta.id,&#10;  name: toolCall._meta.name,&#10;  content: toolCallResult&#10;}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DiscoverAgentCard_ClientAgent</bpmn:incoming>
      <bpmn:outgoing>Flow_ClientAgent_ExposeServerArtifact</bpmn:outgoing>
      <bpmn:subProcess id="DelegateRequest" name="Delegate placeholder request">
        <bpmn:documentation>Send the predefined process-owned demoInput to the remote agent through A2A. Wait for the server to push task updates while submitted or working. Accepts no model arguments. Task/context IDs come only from observed server results. Calling again while a task is active resumes waiting without resending. Returns the actual response separately from the last accepted task so errors cannot masquerade as successful polling.</bpmn:documentation>
        <bpmn:extensionElements>
          <zeebe:ioMapping>
            <zeebe:input source="=demoInput" target="requestData" />
            <zeebe:input source="=(for task in [ (for response in [ (for records in [flatten( for message in agentContext.conversation.messages[item.role = &#34;tool_call_result&#34;] return message.results[item.name = &#34;DelegateRequest&#34;] )] return if count(records) &#62; 0 then (for content in [if records[count(records)].content instance of list then records[count(records)].content[item.type = &#34;object&#34;][1].content else records[count(records)].content] return if content instance of context and get value(content, &#34;toolCallResult&#34;) instance of context then content.toolCallResult else content)[1] else null)[1] ] return for result in [if response instance of context then if get value(response, &#34;task&#34;) instance of context then response.task else get value(response, &#34;result&#34;) else null] return for task in [if result instance of context and get value(result, &#34;task&#34;) instance of context then result.task else result] return if task.id instance of string and task.contextId instance of string then task else null )[1][1][1] ] return if task instance of context then if list contains([&#34;TASK_STATE_COMPLETED&#34;, &#34;TASK_STATE_CANCELED&#34;, &#34;TASK_STATE_FAILED&#34;, &#34;TASK_STATE_REJECTED&#34;], task.status.state) then {contextId: task.contextId} else {taskId: task.id, contextId: task.contextId} else {})[1]" target="previousTask" />
            <zeebe:input source="=null" target="remoteResponse" />
            <zeebe:input source="=(for response in [ (for records in [flatten( for message in agentContext.conversation.messages[item.role = &#34;tool_call_result&#34;] return message.results[item.name = &#34;DelegateRequest&#34;] )] return if count(records) &#62; 0 then (for content in [if records[count(records)].content instance of list then records[count(records)].content[item.type = &#34;object&#34;][1].content else records[count(records)].content] return if content instance of context and get value(content, &#34;toolCallResult&#34;) instance of context then content.toolCallResult else content)[1] else null)[1] ] return for result in [if response instance of context then if get value(response, &#34;task&#34;) instance of context then response.task else get value(response, &#34;result&#34;) else null] return for task in [if result instance of context and get value(result, &#34;task&#34;) instance of context then result.task else result] return if task.id instance of string and task.contextId instance of string then task else null )[1][1][1]" target="acceptedTask" />
            <zeebe:output source="={response: remoteResponse, task: acceptedTask}" target="toolCallResult" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:startEvent id="RemoteRequestStarted" name="Remote request started">
          <bpmn:outgoing>Flow_RemoteRequestStarted_RemoteTaskMode</bpmn:outgoing>
        </bpmn:startEvent>
        <bpmn:exclusiveGateway id="RemoteTaskMode" name="Task already active?" default="Flow_RemoteTaskMode_SendA2AMessage">
          <bpmn:incoming>Flow_RemoteRequestStarted_RemoteTaskMode</bpmn:incoming>
          <bpmn:outgoing>Flow_RemoteTaskMode_RemotePollJoin</bpmn:outgoing>
          <bpmn:outgoing>Flow_RemoteTaskMode_SendA2AMessage</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:serviceTask id="SendA2AMessage" name="Send A2A message" zeebe:modelerTemplate="dev.hansel.a2a.client.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
          <bpmn:extensionElements>
            <zeebe:taskDefinition type="io.camunda:http-json:1" retries="1" />
            <zeebe:ioMapping>
              <zeebe:input source="https://connectors.example.invalid/inbound/a2a" target="baseUrl" />
              <zeebe:input source="noAuth" target="authType" />
              <zeebe:input source="noAuth" target="authentication.type" />
              <zeebe:input source="sendMessage" target="operationId" />
              <zeebe:input source="a2a" target="rpcPath" />
              <zeebe:input source="=&#34;/&#34;+rpcPath" target="operationPath" />
              <zeebe:input source="={}" target="queryParameters" />
              <zeebe:input source="POST" target="method" />
              <zeebe:input source="=&#34;Run the placeholder tool for the supplied demoInput.&#34;" target="text" />
              <zeebe:input source="=get value(previousTask, &#34;taskId&#34;)" target="taskId" />
              <zeebe:input source="=get value(previousTask, &#34;contextId&#34;)" target="contextId" />
              <zeebe:input source="=[{text: text}, {data: {demoInput: requestData}}]" target="messageParts" />
              <zeebe:input source="=string(uuid())" target="pushToken" />
              <zeebe:input source="{{secrets.A2A_CALLBACK_SECRET}}" target="pushCredentials" />
              <zeebe:input source="=null" target="apiKey" />
              <zeebe:input source="=null" target="rpcUrl" />
              <zeebe:input source="=true" target="ignoreNullValues" />
              <zeebe:input source="=true" target="returnImmediately" />
              <zeebe:input source="https://connectors.example.invalid/inbound/a2a-push" target="webhookUrl" />
              <zeebe:input source="={&#34;A2A-Version&#34;: &#34;1.0&#34;, &#34;Content-Type&#34;: &#34;application/json&#34;}" target="headers" />
              <zeebe:input source="=if operationId != &#34;fetchAgentCard&#34; and rpcUrl != null then rpcUrl else baseUrl + operationPath" target="url" />
              <zeebe:input source="={jsonrpc: &#34;2.0&#34;, id: string(uuid()), method: &#34;SendMessage&#34;, params: {message: {messageId: string(uuid()), role: &#34;ROLE_USER&#34;, parts: if messageParts != null then messageParts else [{text: text}], taskId: taskId, contextId: contextId}, configuration: {returnImmediately: if returnImmediately != null then returnImmediately else webhookUrl != null, taskPushNotificationConfig: if webhookUrl != null then {url: webhookUrl, token: pushToken, authentication: {scheme: &#34;Bearer&#34;, credentials: pushCredentials}} else null}}}" target="body" />
              <zeebe:input source="=acceptedTask" target="priorAcceptedTask" />
              <zeebe:output source="=toolCallResult" target="toolCallResult" />
              <zeebe:output source="=remoteResponse" target="remoteResponse" />
              <zeebe:output source="=a2aResult" target="a2aResult" />
              <zeebe:output source="=a2aError" target="a2aError" />
              <zeebe:output source="=(for result in [remoteResponse.result] return for candidate in [if result.task instance of context then result.task else result] return if candidate.id instance of string and candidate.contextId instance of string and candidate.status.state instance of string and (true) then candidate else priorAcceptedTask)[1][1]" target="acceptedTask" />
            </zeebe:ioMapping>
            <zeebe:taskHeaders>
              <zeebe:header key="resultExpression" value="={toolCallResult: response.body, remoteResponse: response.body, a2aResult: response.body.result, a2aError: response.body.error}" />
              <zeebe:header key="retryBackoff" value="PT0S" />
            </zeebe:taskHeaders>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_RemoteTaskMode_SendA2AMessage</bpmn:incoming>
          <bpmn:outgoing>Flow_SendA2AMessage_RemoteTaskAccepted</bpmn:outgoing>
        </bpmn:serviceTask>
        <bpmn:exclusiveGateway id="RemoteTaskAccepted" name="Task returned?" default="Flow_RemoteTaskAccepted_RemoteReplyJoin">
          <bpmn:incoming>Flow_SendA2AMessage_RemoteTaskAccepted</bpmn:incoming>
          <bpmn:outgoing>Flow_RemoteTaskAccepted_RemotePollJoin</bpmn:outgoing>
          <bpmn:outgoing>Flow_RemoteTaskAccepted_RemoteReplyJoin</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:exclusiveGateway id="RemotePollJoin" name="Task active">
          <bpmn:incoming>Flow_RemoteTaskMode_RemotePollJoin</bpmn:incoming>
          <bpmn:incoming>Flow_RemoteTaskAccepted_RemotePollJoin</bpmn:incoming>
          <bpmn:outgoing>Flow_RemotePollJoin_AwaitPush</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:intermediateCatchEvent id="AwaitPush" name="Task update pushed" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnectorIntermediate.v1" zeebe:modelerTemplateVersion="10">
          <bpmn:extensionElements>
            <zeebe:properties>
              <zeebe:property name="inbound.type" value="io.camunda:webhook:1" />
              <zeebe:property name="inbound.method" value="post" />
              <zeebe:property name="inbound.context" value="a2a-push" />
              <zeebe:property name="inbound.shouldValidateHmac" value="disabled" />
              <zeebe:property name="inbound.auth.type" value="APIKEY" />
              <zeebe:property name="inbound.auth.apiKey" value="Bearer {{secrets.A2A_CALLBACK_SECRET}}" />
              <zeebe:property name="inbound.auth.apiKeyLocator" value="=get value(request.headers, &#34;authorization&#34;)" />
              <zeebe:property name="correlationKeyExpression" value="=request.body.task.id" />
              <zeebe:property name="resultVariable" value="" />
              <zeebe:property name="resultExpression" value="={remoteResponse: {result: {task: request.body.task}}, acceptedTask: request.body.task}" />
            </zeebe:properties>
          </bpmn:extensionElements>
          <bpmn:incoming>Flow_RemotePollJoin_AwaitPush</bpmn:incoming>
          <bpmn:outgoing>Flow_AwaitPush_RemoteReplyJoin</bpmn:outgoing>
          <bpmn:messageEventDefinition id="AwaitPush_def" messageRef="Message_A2APush" />
        </bpmn:intermediateCatchEvent>
        <bpmn:boundaryEvent id="PushTimeout" name="No push in 5 min" attachedToRef="AwaitPush">
          <bpmn:outgoing>Flow_PushTimeout_RemoteReplyJoin</bpmn:outgoing>
          <bpmn:timerEventDefinition id="PushTimeout_def">
            <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
          </bpmn:timerEventDefinition>
        </bpmn:boundaryEvent>
        <bpmn:sequenceFlow id="Flow_RemotePollJoin_AwaitPush" sourceRef="RemotePollJoin" targetRef="AwaitPush" />
        <bpmn:sequenceFlow id="Flow_AwaitPush_RemoteReplyJoin" sourceRef="AwaitPush" targetRef="RemoteReplyJoin" />
        <bpmn:sequenceFlow id="Flow_PushTimeout_RemoteReplyJoin" sourceRef="PushTimeout" targetRef="RemoteReplyJoin" />
        <bpmn:exclusiveGateway id="RemoteReplyJoin">
          <bpmn:incoming>Flow_RemoteTaskAccepted_RemoteReplyJoin</bpmn:incoming>
          <bpmn:incoming>Flow_AwaitPush_RemoteReplyJoin</bpmn:incoming>
          <bpmn:incoming>Flow_PushTimeout_RemoteReplyJoin</bpmn:incoming>
          <bpmn:outgoing>Flow_RemoteReplyJoin_RemoteReplyReceived</bpmn:outgoing>
        </bpmn:exclusiveGateway>
        <bpmn:endEvent id="RemoteReplyReceived" name="Remote agent replied">
          <bpmn:incoming>Flow_RemoteReplyJoin_RemoteReplyReceived</bpmn:incoming>
        </bpmn:endEvent>
        <bpmn:sequenceFlow id="Flow_RemoteRequestStarted_RemoteTaskMode" sourceRef="RemoteRequestStarted" targetRef="RemoteTaskMode" />
        <bpmn:sequenceFlow id="Flow_RemoteTaskMode_RemotePollJoin" name="resume waiting" sourceRef="RemoteTaskMode" targetRef="RemotePollJoin">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=if acceptedTask instance of context then list contains(["TASK_STATE_SUBMITTED", "TASK_STATE_WORKING"], acceptedTask.status.state) else false</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_RemoteTaskMode_SendA2AMessage" name="send message" sourceRef="RemoteTaskMode" targetRef="SendA2AMessage" />
        <bpmn:sequenceFlow id="Flow_SendA2AMessage_RemoteTaskAccepted" sourceRef="SendA2AMessage" targetRef="RemoteTaskAccepted" />
        <bpmn:sequenceFlow id="Flow_RemoteTaskAccepted_RemotePollJoin" name="yes" sourceRef="RemoteTaskAccepted" targetRef="RemotePollJoin">
          <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=(for task in [if remoteResponse.result.task instance of context then remoteResponse.result.task else remoteResponse.result] return remoteResponse.error = null and task.id = acceptedTask.id and task.contextId = acceptedTask.contextId and task.status.state instance of string)[1]</bpmn:conditionExpression>
        </bpmn:sequenceFlow>
        <bpmn:sequenceFlow id="Flow_RemoteTaskAccepted_RemoteReplyJoin" name="no task / error" sourceRef="RemoteTaskAccepted" targetRef="RemoteReplyJoin" />
        <bpmn:sequenceFlow id="Flow_RemoteReplyJoin_RemoteReplyReceived" sourceRef="RemoteReplyJoin" targetRef="RemoteReplyReceived" />
      </bpmn:subProcess>
    </bpmn:adHocSubProcess>
    <bpmn:scriptTask id="ExposeServerArtifact" name="Expose returned artifact">
      <bpmn:extensionElements>
        <zeebe:script expression="=(for observed in [ if remoteResult.response.result.task instance of context then remoteResult.response.result.task else remoteResult.response.result] return if remoteResult.response.error = null and observed.id = remoteResult.task.id and observed.contextId = remoteResult.task.contextId and observed.status.state = &#34;TASK_STATE_COMPLETED&#34; then if observed.artifacts instance of list then observed.artifacts[name = &#34;placeholder&#34;][1] else null else null)[1]" resultVariable="serverArtifact" />
        <zeebe:ioMapping>
          <zeebe:output source="=remoteResult.task" target="serverTask" />
          <zeebe:output source="=remoteResult.response" target="a2aResponse" />
          <zeebe:output source="=serverArtifact" target="serverArtifact" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ClientAgent_ExposeServerArtifact</bpmn:incoming>
      <bpmn:outgoing>Flow_ExposeServerArtifact_ArtifactReturned</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="ArtifactReturned" name="Artifact returned?" default="Flow_ArtifactReturned_ClientRequestFailed">
      <bpmn:incoming>Flow_ExposeServerArtifact_ArtifactReturned</bpmn:incoming>
      <bpmn:outgoing>Flow_ArtifactReturned_ClientConversationFinished</bpmn:outgoing>
      <bpmn:outgoing>Flow_ArtifactReturned_ClientRequestFailed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="ClientConversationFinished" name="Artifact available">
      <bpmn:incoming>Flow_ArtifactReturned_ClientConversationFinished</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="ClientRequestFailed" name="A2A request failed">
      <bpmn:incoming>Flow_ArtifactReturned_ClientRequestFailed</bpmn:incoming>
      <bpmn:errorEventDefinition id="ClientRequestFailed_def" errorRef="A2ARequestFailed" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_QuestionAsked_DiscoverAgentCard" sourceRef="QuestionAsked" targetRef="DiscoverAgentCard" />
    <bpmn:sequenceFlow id="Flow_DiscoverAgentCard_ClientAgent" sourceRef="DiscoverAgentCard" targetRef="ClientAgent" />
    <bpmn:sequenceFlow id="Flow_ClientAgent_ExposeServerArtifact" sourceRef="ClientAgent" targetRef="ExposeServerArtifact" />
    <bpmn:sequenceFlow id="Flow_ExposeServerArtifact_ArtifactReturned" sourceRef="ExposeServerArtifact" targetRef="ArtifactReturned" />
    <bpmn:sequenceFlow id="Flow_ArtifactReturned_ClientConversationFinished" name="yes" sourceRef="ArtifactReturned" targetRef="ClientConversationFinished">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=serverArtifact.parts[1].data = demoInput</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_ArtifactReturned_ClientRequestFailed" name="no" sourceRef="ArtifactReturned" targetRef="ClientRequestFailed" />
  </bpmn:process>
  <bpmn:message id="Message_A2APush" name="a2a-push" zeebe:modelerTemplate="io.camunda.connectors.webhook.WebhookConnectorIntermediate.v1">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=acceptedTask.id" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmndi:BPMNDiagram id="BPMNDiagram_a2a-client">
    <bpmndi:BPMNPlane id="BPMNPlane_a2a-client" bpmnElement="a2a-client">
      <bpmndi:BPMNShape id="QuestionAsked_di" bpmnElement="QuestionAsked">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DiscoverAgentCard_di" bpmnElement="DiscoverAgentCard">
        <dc:Bounds x="175" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientAgent_di" bpmnElement="ClientAgent">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ExposeServerArtifact_di" bpmnElement="ExposeServerArtifact">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ArtifactReturned_di" bpmnElement="ArtifactReturned" isMarkerVisible="true">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientConversationFinished_di" bpmnElement="ClientConversationFinished">
        <dc:Bounds x="807" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ClientRequestFailed_di" bpmnElement="ClientRequestFailed">
        <dc:Bounds x="807" y="192" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_QuestionAsked_DiscoverAgentCard_di" bpmnElement="Flow_QuestionAsked_DiscoverAgentCard">
        <di:waypoint x="93" y="70" />
        <di:waypoint x="175" y="70" />
