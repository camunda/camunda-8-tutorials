{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "Process_wctxyvg",
  "testCases": [
    {
      "name": "Order executed and customer informed",
      "description": "The limit price is within the threshold of the market price, so the order is registered, executed and the customer is informed.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "Process_wctxyvg"
          },
          "variables": {
            "customerId": 123,
            "customerMail": "jane.doe@example.com",
            "orderId": 45601,
            "orderDateAndTime": "2026-10-22T09:00:00Z",
            "orderExpiryDate": "2099-01-01T00:00:00Z",
            "orderType": "BUY_LIMIT",
            "stockAmount": 10,
            "stockSymbol": "AAPL",
            "limitPricePerStock": {
              "price": 240,
              "currency": "USD"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_18y2a76"
          },
          "variables": {
            "marketPrice": {
              "price": 240.84,
              "currency": "USD"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_0s29l30"
          },
          "variables": {
            "orderRegistered": true
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "order_executed",
          "correlationKey": "45601",
          "variables": {
            "executionPrice": 240.5
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_1ni426c"
          }
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "Process_wctxyvg"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "Process_wctxyvg"
          },
          "elementSelector": {
            "elementId": "Event_19wbbuh"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "Process_wctxyvg"
          },
          "elementSelectors": [
            {
              "elementId": "Activity_1w8rn3q"
            },
            {
              "elementId": "Event_1sv9v55"
            },
            {
              "elementId": "Activity_1ccl3v1"
            }
          ],
          "state": "IS_NOT_ACTIVATED"
        }
      ]
    },
