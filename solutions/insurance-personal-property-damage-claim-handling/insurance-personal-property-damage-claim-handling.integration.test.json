  "testCases": [
    {
      "name": "Claim approved automatically and paid",
      "description": "A first-time claim for a $150 item under a full policy passes the business rules, so it is approved without an adjuster and paid out.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "Process_1goj4fl"
          },
          "variables": {
            "personal_property": "headphones",
            "maker": "Sony",
            "model": "WH-CH520",
            "date_of_purchase": "2026-03-14T10:00:00Z",
            "price_at_purchase": 150,
            "incident_description": "Dropped on the pavement, the headband snapped."
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_0mmcuzy"
          },
          "variables": {
            "receipt_details": {
              "price_at_purchase": 150,
              "date_of_purchase": "2026-03-14T10:00:00Z",
              "merchant": "Electronics Store"
            }
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_17krtpn"
          },
          "variables": {
            "item": "headphones",
            "damage": "broken headband"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_1vdz63b"
          },
          "variables": {
            "ticketId": "TCK-50101"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_0etxz4e"
          },
          "variables": {
            "customer_claim_frequency_last_three_years": 0,
            "policy": "full"
          }
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_0poax8d"
          }
        },
        {
          "type": "PUBLISH_MESSAGE",
          "name": "banking_info_received",
          "correlationKey": "TCK-50101"
        },
        {
          "type": "COMPLETE_JOB",
          "jobSelector": {
            "elementId": "Activity_0ankyj2"
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "Process_1goj4fl"
          },
          "elementSelector": {
            "elementId": "Event_088b3ko"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "Process_1goj4fl"
          },
          "variables": {
            "isApproved": true,
            "deductible": 30
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "Process_1goj4fl"
          },
          "elementSelectors": [
            {
              "elementId": "Activity_1afcosf"
            },
            {
              "elementId": "Event_0vn5a71"
            }
          ],
          "state": "IS_NOT_ACTIVATED"
        }
      ]
    },
