{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "ai-agent-chat-with-tools",
  "testCases": [
    {
      "name": "Agent segment \u2014 joke and recipe tools",
      "description": "Starts immediately before the AI Agent with a predefined prompt, asserts the expected tool/path, and terminates at the earliest useful assertion point. Runs the real agent, Camunda-provided LLM, and public HTTP APIs. Verifies that a multi-part request reaches both expected tools and exposes their results without asserting order or response wording.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "inputText": "Tell me a safe joke and find a pasta recipe.",
            "inputDocuments": []
          },
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "AI_Agent"
            }
          ],
          "startInstructions": [
            {
              "elementId": "AI_Agent"
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "FetchSafeJoke"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "SearchRecipes"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variableNames": [
            "toolCallResults"
          ],
          "elementSelector": {
            "elementId": "AI_Agent"
          }
        }
      ]
    },
    {
      "name": "Agent segment \u2014 sample users and products",
      "description": "Starts immediately before the AI Agent with a predefined prompt, asserts the expected tool/path, and terminates at the earliest useful assertion point. Runs the real agent, Camunda-provided LLM, and public HTTP APIs. In one agent segment, verifies both expected tool selections and exposes their results without asserting order or response wording.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "inputText": "List the available users and tell me which sample technology products are available.",
            "inputDocuments": []
          },
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "AI_Agent"
            }
          ],
          "startInstructions": [
            {
              "elementId": "AI_Agent"
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "LookupSampleUsers"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "ListSampleTechnologyProducts"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variableNames": [
            "toolCallResults"
          ],
          "elementSelector": {
            "elementId": "AI_Agent"
          }
        }
      ]
    },
    {
      "name": "Live E2E \u2014 reject feedback then approve final answer",
      "description": "Runs the complete process through the agent, live connectors, a rejected response, a follow-up answer, and final user approval. The named business outcome is a completed process instance; the test asserts each expected tool and terminal state without asserting tool order or response wording.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "inputText": "Tell me a safe joke and find a pasta recipe.",
            "inputDocuments": []
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "FetchSafeJoke"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "SearchRecipes"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": {
            "elementId": "UserTask_ReviewAgentResponse"
          },
          "variables": {
            "userSatisfied": false,
            "followUpInput": "That is helpful, but please also list the available users and tell me which sample technology products are available.",
            "followUpDocuments": []
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "LookupSampleUsers"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "ListSampleTechnologyProducts"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "UserTask_ReviewAgentResponse"
          },
          "state": "IS_ACTIVE"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": {
            "elementId": "UserTask_ReviewAgentResponse"
          },
          "variables": {
            "userSatisfied": true
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "AI_Agent"
          },
          "state": "IS_COMPLETED",
          "amount": 2
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "UserTask_ReviewAgentResponse"
          },
          "state": "IS_COMPLETED",
          "amount": 2
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Live connector integration \u2014 list users returns users",
      "description": "Runs only the real HTTP connector against JSONPlaceholder and verifies that the connector completes with a result.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "toolCall": {
              "_meta": {
                "id": "LookupSampleUsers",
                "name": "LookupSampleUsers"
              }
            }
          },
          "startInstructions": [
            {
              "elementId": "LookupSampleUsers"
            }
