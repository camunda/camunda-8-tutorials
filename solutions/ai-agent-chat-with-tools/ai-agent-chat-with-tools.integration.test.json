{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "ai-agent-chat-with-tools",
  "testCases": [
    {
      "name": "Live connector integration - list users returns users",
      "description": "Runs only the real HTTP connector against JSONPlaceholder and verifies that it returns at least one named user.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "toolCall": {
              "_meta": {
                "id": "list-users-integration",
                "name": "ListUsers"
              }
            }
          },
          "startInstructions": [
            {
              "elementId": "ListUsers"
            }
          ],
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "ListUsers"
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "ListUsers"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCES",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelectors": [
            {
              "elementId": "Search_Recipe"
            },
            {
              "elementId": "Jokes_API"
            },
            {
              "elementId": "Activity_0x3prgn"
            },
            {
              "elementId": "User_Feedback"
            }
          ],
          "state": "IS_NOT_ACTIVATED"
        },
        {
          "type": "ASSERT_VARIABLE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variableName": "toolCallResult",
          "satisfiesExpression": "toolCallResult != null and count(toolCallResult) > 0 and (some user in toolCallResult satisfies user.id = 1 and user.name = \"Leanne Graham\" and user.username = \"Bret\")"
        }
      ]
    },
