{
  "$schema": "https://camunda.com/json-schema/cpt-test-cases/8.10/schema.json",
  "processId": "ai-agent-chat-with-tools",
  "testCases": [
    {
      "name": "Live E2E \u2014 agent uses joke and recipe tools",
      "description": "Runs the real agent, Camunda-provided LLM, and public HTTP APIs. Verifies that a multi-part request reaches both expected tools and exposes their results without asserting order or response wording.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "inputText": "Tell me a safe joke and find a pasta recipe.",
            "inputDocuments": []
          },
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "AI_Agent"
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "Jokes_API"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "Search_Recipe"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variableNames": [
            "toolCallResults"
          ],
          "elementSelector": {
            "elementId": "AI_Agent"
          }
        }
      ]
    },
    {
      "name": "Live E2E \u2014 agent uses users and technology tools",
      "description": "Runs the real agent, Camunda-provided LLM, and public HTTP APIs. In one agent segment, verifies both expected tool selections and exposes their results without asserting order or response wording.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "inputText": "List the available users and tell me which sample technology products are available.",
            "inputDocuments": []
          },
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "AI_Agent"
            }
          ]
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "ListUsers"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "Activity_0x3prgn"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_VARIABLES",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variableNames": [
            "toolCallResults"
          ],
          "elementSelector": {
            "elementId": "AI_Agent"
          }
        }
      ]
    },
    {
      "name": "Live E2E \u2014 user rejects then approves",
      "description": "Runs the complete process with the real agent and connectors. The first turn calls joke and recipe, the user rejects with a users and technology follow-up, and the second turn calls both remaining tools before approval.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "variables": {
            "inputText": "Tell me a safe joke and find a pasta recipe.",
            "inputDocuments": []
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "Jokes_API"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "Search_Recipe"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": {
            "elementId": "User_Feedback"
          },
          "variables": {
            "userSatisfied": false,
            "followUpInput": "That is helpful, but please also list the available users and tell me which sample technology products are available.",
            "followUpDocuments": []
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "ListUsers"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "Activity_0x3prgn"
          },
          "state": "IS_COMPLETED"
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "User_Feedback"
          },
          "state": "IS_ACTIVE"
        },
        {
          "type": "COMPLETE_USER_TASK",
          "userTaskSelector": {
            "elementId": "User_Feedback"
          },
          "variables": {
            "userSatisfied": true
          }
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "AI_Agent"
          },
          "state": "IS_COMPLETED",
          "amount": 2
        },
        {
          "type": "ASSERT_ELEMENT_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "elementSelector": {
            "elementId": "User_Feedback"
          },
          "state": "IS_COMPLETED",
          "amount": 2
        },
        {
          "type": "ASSERT_PROCESS_INSTANCE",
          "processInstanceSelector": {
            "processDefinitionId": "ai-agent-chat-with-tools"
          },
          "state": "IS_COMPLETED"
        }
      ]
    },
    {
      "name": "Live connector integration \u2014 list users returns users",
