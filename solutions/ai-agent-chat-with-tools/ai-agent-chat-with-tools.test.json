          "variables": {
            "toolCall": {
              "_meta": {
                "id": "list-users-integration",
                "name": "ListUsers"
              }
            }
          },
          "startInstructions": [
            {
              "elementId": "ListUsers"
            }
          ],
          "runtimeInstructions": [
            {
              "type": "TERMINATE_PROCESS_INSTANCE",
              "afterElementId": "ListUsers"
