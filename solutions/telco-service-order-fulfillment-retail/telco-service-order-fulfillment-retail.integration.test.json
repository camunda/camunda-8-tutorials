    {
      "name": "High-value order aborted as fraud",
      "description": "A one-time total above 3,000 triggers the fraud check, which detects fraud, so the attempt is recorded and the order is aborted.",
      "instructions": [
        {
          "type": "CREATE_PROCESS_INSTANCE",
          "processDefinitionSelector": {
            "processDefinitionId": "telco_service_order_fulfillment_retail"
          },
          "variables": {
            "orderId": "SO-1003",
            "customerId": "CUST-4713",
            "orderItems": [
              {
                "orderItemId": 30,
                "type": "hardware",
                "product": "Smartphone Ultra Pro (x4)",
                "price": 5200
              },
              {
                "orderItemId": 31,
                "type": "mobile",
                "product": "Unlimited 5G plan",
                "price": 45,
                "reocurring": "monthly"
              }
            ]
          }
        },
        {
          "type": "THROW_BPMN_ERROR_FROM_JOB",
          "jobSelector": {
            "elementId": "Activity_1rg0k6z"
